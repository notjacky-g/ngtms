<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
	xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
	xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
	xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button"
	xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid">

	<ui:with field="messages" type="com.hwacom.ngtms.common.am.view.Messages" />

	<ui:with field="margins4444" type="com.sencha.gxt.core.client.util.Margins">
		<ui:attributes top="4" right="4" bottom="4" left="4" />
	</ui:with>
	<ui:with field="margins4044" type="com.sencha.gxt.core.client.util.Margins">
		<ui:attributes top="4" right="0" bottom="4" left="4" />
	</ui:with>
	<ui:with field="margins4404" type="com.sencha.gxt.core.client.util.Margins">
		<ui:attributes top="4" right="4" bottom="0" left="4" />
	</ui:with>

	<ui:with field="eastLayoutData" type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData">
		<ui:attributes size="380" collapsible="true" split="true" margins="{margins4444}"/>
	</ui:with>
	<ui:with field="centerLayoutData" type="com.sencha.gxt.widget.core.client.container.MarginData" >
		<ui:attributes margins="{margins4044}"/>
	</ui:with>
	<ui:with field="fieldVerLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
		<ui:attributes width="1" height="30" margins="{margins4404}"/>
	</ui:with>
	
	<ui:with field="listStore" type="com.sencha.gxt.data.shared.ListStore"/>
    <ui:with field="columnModel" type="com.sencha.gxt.widget.core.client.grid.ColumnModel"/>
    <ui:with field="gridView" type="com.sencha.gxt.widget.core.client.grid.GridView">
        <ui:attributes stripeRows="true" />
    </ui:with>

	<container:BorderLayoutContainer>
		<container:east layoutData="{eastLayoutData}">
			<gxt:FramedPanel heading="{messages.editData}"
                			 buttonAlign="CENTER">
				<container:VerticalLayoutContainer>
					<container:child layoutData="{fieldVerLayoutData}">
						<form:FieldLabel text="{messages.unit_name}"
										 labelWidth="80">
							<form:widget>
								<form:TextField ui:field="nameField"
												allowBlank="false" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{fieldVerLayoutData}">
						<form:FieldLabel text="{messages.unit_fullName}"
										 labelWidth="80">
							<form:widget>
								<form:TextField ui:field="fullNameField"
												allowBlank="false" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{fieldVerLayoutData}">
						<form:FieldLabel text="{messages.unit_manInCharge}"
										 labelWidth="80">
							<form:widget>
								<form:TextField ui:field="manInChargeField" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{fieldVerLayoutData}">
						<form:FieldLabel text="{messages.unit_address}"
										 labelWidth="80">
							<form:widget>
								<form:TextField ui:field="addressField" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{fieldVerLayoutData}">
						<form:FieldLabel text="{messages.unit_email}"
										 labelWidth="80">
							<form:widget>
								<form:TextField ui:field="emailField" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{fieldVerLayoutData}">
						<form:FieldLabel text="{messages.unit_phone}"
										 labelWidth="80">
							<form:widget>
								<form:TextField ui:field="phoneField" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{fieldVerLayoutData}">
						<form:FieldLabel text="{messages.unit_fax}"
										 labelWidth="80">
							<form:widget>
								<form:TextField ui:field="faxField" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{fieldVerLayoutData}">
						<form:FieldLabel text="{messages.unit_taxId}"
										 labelWidth="80">
							<form:widget>
								<form:TextField ui:field="taxIdField" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{fieldVerLayoutData}">
						<form:FieldLabel text="{messages.unit_description}"
										 labelWidth="80">
							<form:widget>
								<form:TextField ui:field="descriptionField" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{fieldVerLayoutData}">
						<form:FieldLabel text="{messages.unit_approve}"
										 labelWidth="80">
							<form:widget>
								<form:CheckBox ui:field="approveCheckBox"/>
							</form:widget>
						</form:FieldLabel>
					</container:child>
				</container:VerticalLayoutContainer>
				<gxt:button>
                    <button:TextButton ui:field="addButton"
                        			   text="{messages.button_add}" />
                </gxt:button>
                <gxt:button>
                    <button:TextButton ui:field="deleteButton"
                        			   text="{messages.button_delete}" />
                </gxt:button>
                <gxt:button>
                    <button:TextButton ui:field="saveButton"
                        			   text="{messages.button_save}" />
                </gxt:button>
			</gxt:FramedPanel>
		</container:east>
		<container:center layoutData="{centerLayoutData}">
			<grid:Grid ui:field="grid"
					   store="{listStore}"
					   cm="{columnModel}"
					   view="{gridView}" />
		</container:center>
	</container:BorderLayoutContainer>
</ui:UiBinder> 
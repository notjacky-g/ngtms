<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button"
    xmlns:tree="urn:import:com.sencha.gxt.widget.core.client.tree"
    xmlns:report="urn:import:com.hwacom.ngtms.common.am.view">

    <ui:import field="com.sencha.gxt.widget.core.client.button.ToolButton.COLLAPSE" />
    <ui:import field="com.sencha.gxt.widget.core.client.button.ToolButton.EXPAND" />

    <ui:with type="com.hwacom.ngtms.common.am.view.Messages" field="messages" />

    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margin4444">
        <ui:attributes top="4" right="4" bottom="4" left="4" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="centerMargins">
        <ui:attributes top="4" right="4" bottom="4" left="0" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins0040">
        <ui:attributes top="0" right="0" bottom="4" left="0" />
    </ui:with>

    <ui:with type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData" field="westLayoutData">
        <ui:attributes size="225" margins="{margin4444}" collapsible="true" split="true" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData" field="southLayoutData">
        <ui:attributes size="700" collapsible="false" split="true" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.container.MarginData" field="centerLayoutData">
        <ui:attributes margins="{centerMargins}" />
    </ui:with>

    <ui:with type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData" field="inputParameterLayoutData">
        <ui:attributes width="1.0" height="0.3" margins="{margins0040}" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData" field="toolBarLayoutData">
        <ui:attributes width="1.0" height="32" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData" field="previewLayoutData">
        <ui:attributes width="1.0" height="1.0" />
    </ui:with>

    <ui:with type="com.sencha.gxt.data.shared.TreeStore" field="treeStore" />
    <ui:with type="com.sencha.gxt.core.client.ValueProvider" field="treeValueProvider" />

    <container:BorderLayoutContainer ui:field="container">
        <container:west layoutData="{westLayoutData}">
            <gxt:ContentPanel>
                <gxt:tool>
                    <button:ToolButton ui:field="allExpand" config="{EXPAND}" toolTip="{messages.tree_expandAll}" />
                </gxt:tool>
                <gxt:tool>
                    <button:ToolButton ui:field="allCollapse" config="{COLLAPSE}" toolTip="{messages.tree_collapseAll}" />
                </gxt:tool>
                <gxt:widget>
                    <tree:Tree ui:field="tree" store="{treeStore}" valueProvider="{treeValueProvider}" />
                </gxt:widget>
            </gxt:ContentPanel>
        </container:west>
        <container:center layoutData="{centerLayoutData}">
            <container:BorderLayoutContainer>
                <container:center>
                    <container:SimpleContainer ui:field="inputParameterContainer" />
                </container:center>
                <container:south layoutData="{southLayoutData}">
                  <gxt:ContentPanel headerVisible="false" >
                      <container:VerticalLayoutContainer>
                          <container:child layoutData="{toolBarLayoutData}" >
                              <report:ReportToolBar ui:field="toolBar" enabled="false" />
                          </container:child>
                          <container:child layoutData="{previewLayoutData}">
                              <g:ScrollPanel>
                                  <g:HTML ui:field="previewContent" />
                              </g:ScrollPanel>
                          </container:child>
                      </container:VerticalLayoutContainer>
                  </gxt:ContentPanel>
                </container:south>
            </container:BorderLayoutContainer>
        </container:center>
    </container:BorderLayoutContainer>
</ui:UiBinder>
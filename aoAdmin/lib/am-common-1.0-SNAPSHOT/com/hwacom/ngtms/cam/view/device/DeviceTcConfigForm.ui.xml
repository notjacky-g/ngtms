<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form">

    <ui:with type="com.hwacom.ngtms.common.am.view.Messages" field="messages" />

    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4444">
        <ui:attributes top="4" right="4" bottom="4" left="4" />
    </ui:with>

    <ui:with type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData" field="verticalLayoutData">
        <ui:attributes margins="{margins4444}" width="300" />
    </ui:with>

    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="locationTypeLabelProvider" />

    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="rampTypeLabelProvider" />

    <container:VerticalLayoutContainer scrollMode="AUTO">
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_milepost}" labelWidth="130">
                <form:widget>
                    <form:IntegerField ui:field="milepost" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_mfccId}" labelWidth="130">
                <form:widget>
                    <form:TextField ui:field="mfccId" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_defaultMfccId}" labelWidth="130">
                <form:widget>
                    <form:TextField ui:field="defaultMfccId" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_lineId}" labelWidth="130">
                <form:widget>
                    <form:TextField ui:field="lineId" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_sectionId}" labelWidth="130">
                <form:widget>
                    <form:TextField ui:field="sectionId" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_location}" labelWidth="130">
                <form:widget>
                    <form:SimpleComboBox ui:field="locationType" labelProvider="{locationTypeLabelProvider}"
                        editable="false" triggerAction="ALL" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_locationR}" labelWidth="130">
                <form:widget>
                    <form:SimpleComboBox ui:field="rampType" labelProvider="{rampTypeLabelProvider}"
                        editable="false" triggerAction="ALL" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
    </container:VerticalLayoutContainer>
</ui:UiBinder> 
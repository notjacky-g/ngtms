.titleLeft {
  gwt-sprite: "headerLeft";
  background-size: 100% 100%;
  background-repeat: repeat;
  width: 100%;
  height: 100%;
}

.titleRight {
  gwt-sprite: "headerRight";
  background-size: 100% 100%;
  background-repeat: repeat;
  width: 100%;
  height: 100%;
}

.redAlarm {
  gwt-sprite: "alarm";
  cursor: pointer;
  width: 47px;
  height: 38px;
}

.alarmText {
  gwt-sprite: "alarmText";
}

.titleColor {
  color: white;
  font-family: 'Microsoft JhengHei';
  font-size: 8px;
}

.userText {
  color: white;
  font-family: 'Microsoft JhengHei';
  font-size: 8px;
  height: 60px;
}

.itemStyle {
  font-weight: bold;
  font-size: 28px;
  color: white;
}

.redAlarmStyle {
  font-weight: bold;
  text-align: center;
  font-size: 14px;
  color: white;
}

.alarmText1Style {
  font-size: 11px;
  color: #fb5615;
  width: 450px;
  margin: 0 auto;
  overflow: hidden;
  white-space: nowrap;
  box-sizing: border-box;
  animation: marquee 10s linear infinite;
}

.alarmText1Style:hover {
  animation-play-state: paused;
}

.alarmText2Style {
  font-size: 11px;
  color: #bc4539;
  width: 450px;
  margin: 0 auto;
  overflow: hidden;
  white-space: nowrap;
  box-sizing: border-box;
  animation: marquee 10s linear infinite;
}

.alarmText2Style:hover {
  animation-play-state: paused;
}

.alarmText3Style {
  text-align: center;
  font-size: 11px;
  color: #481c0b;
  width: 450px;
  margin: 0 auto;
  overflow: hidden;
  white-space: nowrap;
  box-sizing: border-box;
  animation: marquee 12s linear infinite;
}
@keyframes marquee {
    0%   { text-indent: 27.5em }
    100% { text-indent: -20em }
}
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:core="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button"
    xmlns:toolbar="urn:import:com.sencha.gxt.widget.core.client.toolbar"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
    xmlns:am="urn:import:com.hwacom.ngtms.cam.client.ui">

    <ui:with field="messages" type="com.hwacom.ngtms.cam.view.Messages" />
    <ui:with field="allImages" type="com.hwacom.ngtms.cam.images.AmImages" />

    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins01500">
        <ui:attributes top="0" right="15" bottom="0" left="0" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4224">
        <ui:attributes top="4" right="2" bottom="2" left="4" />
    </ui:with>

    <ui:with field="itemData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes width="1" height="30" margins="{margins4224}" />
    </ui:with>
    <ui:with field="itemValueData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="1" height="1" margins="{margins01500}" />
    </ui:with>

    <container:VerticalLayoutContainer scrollMode="AUTOY">
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_deviceName}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:TextField ui:field="deviceName"
        							layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_displayName}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:TextField ui:field="displayName"
        							layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_milepost}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:IntegerField ui:field="milepost"
        							   layoutData="{itemValueData}"
        							   enabled="true"
        							   allowBlank="false" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_ip}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:TextField ui:field="ip"
        						    layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_port}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:TextField ui:field="port"
        						    layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_mfccId}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:TextField ui:field="mfccId"
        						    layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_defaultMfccId}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:TextField ui:field="defaultMfccId"
        						    layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_project}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:TextField ui:field="project"
        						    layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_lineName}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:ComboBox ui:field="lineNameCombo"
        						   editable="false"
        						   triggerAction="ALL"
        						   layoutData="{itemValueData}" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_direction}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:ComboBox ui:field="directionCombo"
        						   editable="false"
        						   triggerAction="ALL"
        						   layoutData="{itemValueData}" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_sectionId}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:ComboBox ui:field="roadSectionCombo"
        						   editable="false"
        						   triggerAction="ALL"
        						   layoutData="{itemValueData}" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_location}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:ComboBox ui:field="locationTypeCombo"
        						   editable="false"
        						   triggerAction="ALL"
        						   allowBlank="false"
        						   layoutData="{itemValueData}" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_locationR}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:ComboBox ui:field="rampTypeCombo"
        						   editable="false"
        						   triggerAction="ALL"
        						   allowBlank="false"
        						   layoutData="{itemValueData}" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_longitude}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:DoubleField ui:field="longitude"
        						 	   layoutData="{itemValueData}"
        							   enabled="true"
        							   allowBlank="false" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_latitude}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:DoubleField ui:field="latitude"
        						  	   layoutData="{itemValueData}"
        							   enabled="true"
        							   allowBlank="false" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_memo}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:TextField ui:field="memo"
        						    layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
        <container:child layoutData="{itemData}">
        	<form:FieldLabel text="{messages.deviceConfig_enable}" 
        				 	 labelWidth="120">
        		<form:widget>
        			<form:ComboBox ui:field="enableCombo"
        						   editable="false"
        						   triggerAction="ALL"
        						   layoutData="{itemValueData}" />
        		</form:widget>
        	</form:FieldLabel>
        </container:child>  
    </container:VerticalLayoutContainer>
</ui:UiBinder> 
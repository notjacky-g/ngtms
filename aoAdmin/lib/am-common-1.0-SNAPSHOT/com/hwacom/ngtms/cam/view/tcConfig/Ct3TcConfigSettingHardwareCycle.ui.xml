<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container">

	<ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins00080">
    	<ui:attributes top="0" right="0" bottom="0" left="80" />
    </ui:with>
    
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins01500">
        <ui:attributes top="0" right="15" bottom="0" left="0" />
    </ui:with>
    
    <ui:with field="radioHorLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
    	<ui:attributes width="80" height="1" />
    </ui:with>
    
 	<container:VerticalLayoutContainer  ui:field="verticalLayoutContainer">
    	<container:child>
   			<form:FieldLabel text="硬體狀態回報週期"
   							 labelWidth="120" >
       			<form:widget>
           			<container:HorizontalLayoutContainer>
		                <container:child layoutData="{radioHorLayoutData}">
		                	<form:Radio ui:field="termination"
		                                boxLabel="停止傳送" />
		                </container:child>
		                <container:child layoutData="{radioHorLayoutData}">
		                    <form:Radio ui:field="oneSecond"
		                                boxLabel="1秒" />
		                </container:child>
		                <container:child layoutData="{radioHorLayoutData}">
		                    <form:Radio ui:field="twoSeconds"
		                                boxLabel="2秒" />
		                </container:child>
		                <container:child layoutData="{radioHorLayoutData}">
		                    <form:Radio ui:field="fiveSeconds"
		                                boxLabel="5秒" />
		                </container:child>
		                <container:child layoutData="{radioHorLayoutData}">
		                    <form:Radio ui:field="oneMinute"
		                                boxLabel="1分" />
		                </container:child>
		                <container:child layoutData="{radioHorLayoutData}">
		                    <form:Radio ui:field="fiveMinutes"
		                                boxLabel="5分" />
	                	</container:child>
              		</container:HorizontalLayoutContainer>
          		</form:widget>
   			</form:FieldLabel>
		</container:child>
	</container:VerticalLayoutContainer>
</ui:UiBinder> 
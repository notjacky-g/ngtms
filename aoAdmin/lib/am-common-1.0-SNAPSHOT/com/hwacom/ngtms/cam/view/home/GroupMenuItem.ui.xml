<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
    xmlns:c="urn:import:com.hwacom.ngtms.cam.client.ui.component"
    xmlns:core="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container">

    <ui:with type="com.sencha.gxt.core.client.util.Margins"
        field="margins0">
        <ui:attributes top="0" right="0" bottom="0" left="0" />
    </ui:with>

    <ui:with
        type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData"
        field="fullData">
        <ui:attributes width="1" height="1" margins="{margins0}" />
    </ui:with>

    <core:ContentPanel headerVisible="false">
        <container:VerticalLayoutContainer
            scrollMode="AUTOY" layoutData="{fullData}">
            <c:ScrollFloatContainer ui:field="groupItemPanel" />
        </container:VerticalLayoutContainer>
    </core:ContentPanel>

</ui:UiBinder>
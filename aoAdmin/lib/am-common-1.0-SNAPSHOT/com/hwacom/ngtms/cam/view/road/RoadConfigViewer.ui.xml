<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui" 
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
    xmlns:tree="urn:import:com.sencha.gxt.widget.core.client.tree"
    xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button" 
    xmlns:r="urn:import:com.hwacom.ngtms.cam.view.road">

    <ui:with field="messages" type="com.hwacom.ngtms.cam.view.Messages" />

	<ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4044">
        <ui:attributes top="4" right="0" bottom="4" left="4" />
    </ui:with>

    <ui:with field="westData" type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData">
        <ui:attributes size="250" margins="{margins4044}" />
    </ui:with>
    <ui:with field="comboItemValueData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="100" height="22" />
    </ui:with>
    <ui:with field="fullData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="1" height="1" />
    </ui:with>

	<ui:with type="com.sencha.gxt.data.shared.TreeStore" field="treeStore" />
    <ui:with type="com.sencha.gxt.core.client.ValueProvider" field="treeValueProvider" />

    <container:BorderLayoutContainer>
	    <container:west layoutData="{westData}">
	        <gxt:ContentPanel>
                <gxt:tool>
                	<form:FieldLabel text="請選擇"
                					 labelWidth="80"
                					 height="22">
                		<form:widget>
                			<form:ComboBox ui:field="roadTypeCombo"
		                    			   editable="false"
		                    			   triggerAction="ALL"
		                    			   layoutData="{comboItemValueData}" />
                		</form:widget>
                	</form:FieldLabel>
                </gxt:tool>  
                <tree:Tree ui:field="tree"
                		   valueProvider="{treeValueProvider}"
                		   store="{treeStore}"
                		   layoutData="{fullData}"  />
	        </gxt:ContentPanel>
	    </container:west>
        <container:center>
            <container:CardLayoutContainer ui:field="cardlayout"
               							   layoutData="{fullData}">
	            <r:RoadLineConfigViewer ui:field="roadLineConfigViewer" />
	            <r:ServiceAreaViewer ui:field="serviceAreaViewer" />
	            <r:InterchangeViewer ui:field="interchangeViewer" />
	            <r:SystemInterchangeViewer ui:field="systemInterchangeViewer" />
	        </container:CardLayoutContainer>
        </container:center>
    </container:BorderLayoutContainer>
</ui:UiBinder> 
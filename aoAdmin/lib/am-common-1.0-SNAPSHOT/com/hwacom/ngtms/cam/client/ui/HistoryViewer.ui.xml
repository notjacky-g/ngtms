<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:c="urn:import:com.sencha.gxt.widget.core.client.container" 
    xmlns:core="urn:import:com.sencha.gxt.widget.core.client" 
    xmlns:f="urn:import:com.sencha.gxt.widget.core.client.form" 
    xmlns:t="urn:import:com.sencha.gxt.widget.core.client.toolbar" 
    xmlns:am="urn:import:com.hwacom.ngtms.cam.client.ui" 
    xmlns:b="urn:import:com.sencha.gxt.widget.core.client.button"
    xmlns:chart="urn:import:com.hwacom.ngtms.cam.client.ui.chart" 
    xmlns:cpnt="urn:import:com.hwacom.ngtms.cam.client.ui.component" 
    xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid"
    xmlns:common="urn:import:com.hwacom.ngtms.common.am.view">

    <!-- I18N、Resource -->
    <!-- ==== -->

    <!-- Layout Data 區 -->
    <ui:with field="inputMargin" type="com.sencha.gxt.core.client.util.Margins">
        <ui:attributes top="5" right="0" bottom="5" left="10" />
    </ui:with>
    <ui:with field="inputLD" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData" >
        <ui:attributes width="1" height="35" margins="{inputMargin}" />
    </ui:with>
    <ui:with field="dateTimeLD" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData" >
        <ui:attributes width="300" height="1" />
    </ui:with>
    <ui:with field="margin_l10" type="com.sencha.gxt.core.client.util.Margins">
        <ui:attributes top="0" right="0" bottom="0" left="10" />
    </ui:with>
    <ui:with field="buttonLD" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData" >
        <ui:attributes margins="{margin_l10}" />
    </ui:with>
    <ui:with field="chartVLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes height="1" width="1"/>
    </ui:with>
    <ui:with field="gridLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes width="1" height="200" />
    </ui:with>
    <!-- ==== -->

    <!-- 其他 import / with -->
    <ui:with field="gridView" type="com.sencha.gxt.widget.core.client.grid.GroupingView">
        <ui:attributes forceFit="true"/>
    </ui:with>
    <!-- ==== -->

    <c:BorderLayoutContainer ui:field="root">
        <c:center>
            <core:ContentPanel ui:field="mainPanel">
                <c:VerticalLayoutContainer ui:field="content">
                    <c:HorizontalLayoutContainer layoutData="{inputLD}" scrollMode="AUTOX">
                    	<t:LabelToolItem label="起訖時間:" />
                    	<common:DateRangePicker ui:field="dateRangePicker" 
												timePicker="true" 
												singleDatePicker="false" />
                        <b:TextButton ui:field="submitBtn" text="確定" layoutData="{buttonLD}" /><!-- I18N -->
                        <b:TextButton ui:field="printBtn" text="列印" layoutData="{buttonLD}" /><!-- I18N -->
                    </c:HorizontalLayoutContainer>

                    <!-- 這邊會塞進各子系統的自訂 option widget -->

                    <chart:TimeLineChart ui:field="chart" layoutData="{chartVLayoutData}" />
                    <grid:Grid ui:field="grid" layoutData="{gridLayoutData}" view="{gridView}" />
                </c:VerticalLayoutContainer>
            </core:ContentPanel>
        </c:center>
    </c:BorderLayoutContainer>
</ui:UiBinder>
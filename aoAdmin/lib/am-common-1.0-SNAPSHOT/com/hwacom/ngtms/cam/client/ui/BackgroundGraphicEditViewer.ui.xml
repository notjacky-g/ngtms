<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid"
    xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
    xmlns:gwtupload="urn:import:gwtupload.client"
    xmlns:common="urn:import:com.hwacom.ngtms.cam.client.ui">

    <ui:with type="com.hwacom.ngtms.cam.view.Messages" field="messages" />

    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4444">
        <ui:attributes top="4" right="4" bottom="4" left="4" />
    </ui:with>

    <ui:with type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData" field="leftHorizontalLayoutData">
        <ui:attributes margins="{margins4444}" width="0.5" height="1.0"  />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData" field="rightHorizontalLayoutData">
        <ui:attributes margins="{margins4444}" width="0.5" height="1.0"  />
    </ui:with>

    <ui:with type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData" field="verticalLayoutData">
        <ui:attributes margins="{margins4444}" width="320" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData" field="imageVerticalLayoutData">
        <ui:attributes margins="{margins4444}" width="136" />
    </ui:with>

    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="listStore" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.ColumnModel" field="columnModel" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.GridView" field="gridView">
        <ui:attributes stripeRows="true" />
    </ui:with>

    <container:HorizontalLayoutContainer>
        <container:child layoutData="{leftHorizontalLayoutData}">
            <gxt:ContentPanel headerVisible="false">
                <gxt:widget>
                    <grid:Grid ui:field="grid"
                               store="{listStore}"
                               cm="{columnModel}"
                               view="{gridView}" />
                </gxt:widget>
                <gxt:button>
                    <button:TextButton ui:field="downloadAll"
                                       text="{messages.backgroundGraphic_edit_button_downloadAll}"
                                       enabled="false" />
                </gxt:button>
                <gxt:button>
                    <button:TextButton ui:field="download"
                                       text="{messages.backgroundGraphic_edit_button_download}"
                                       enabled="false" />
                </gxt:button>
            </gxt:ContentPanel>
        </container:child>
        <container:child layoutData="{rightHorizontalLayoutData}">
            <gxt:ContentPanel headerVisible="false">
                <gxt:widget>
                    <container:VerticalLayoutContainer scrollMode="AUTO">
                        <container:child layoutData="{verticalLayoutData}">
                            <form:FieldLabel text="{messages.backgroundGraphic_edit_description}">
                                <form:widget>
                                    <form:TextField ui:field="description" allowBlank="false" />
                                </form:widget>
                            </form:FieldLabel>
                        </container:child>
                        <container:child layoutData="{verticalLayoutData}">
                            <gwtupload:SingleUploader ui:field="uploader"
                                                      type="BUTTON"
                                                      multipleSelection="false"
                                                      autoSubmit="true">
                                <gwtupload:button>
                                    <common:BackgroundGraphicEditViewer.ClickTextButton text="{messages.backgroundGraphic_edit_upload}" />
                                </gwtupload:button>
                            </gwtupload:SingleUploader>
                        </container:child>
                        <container:child layoutData="{imageVerticalLayoutData}">
                            <g:Image ui:field="graphic"/>
                        </container:child>
                    </container:VerticalLayoutContainer>
                </gxt:widget>
                <gxt:button>
                    <button:TextButton ui:field="create"
                                       text="{messages.backgroundGraphic_edit_button_create}"
                                       enabled="false" />
                </gxt:button>
                <gxt:button>
                    <button:TextButton ui:field="modify" text="{messages.backgroundGraphic_edit_button_modify}"/>
                </gxt:button>
                <gxt:button>
                    <button:TextButton ui:field="remove" text="{messages.backgroundGraphic_edit_button_remove}"/>
                </gxt:button>
            </gxt:ContentPanel>
        </container:child>
    </container:HorizontalLayoutContainer>
</ui:UiBinder> 
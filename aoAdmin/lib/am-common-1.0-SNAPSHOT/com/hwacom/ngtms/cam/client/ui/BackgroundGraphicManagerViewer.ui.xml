<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:common="urn:import:com.hwacom.ngtms.cam.client.ui">

    <ui:with type="com.hwacom.ngtms.cam.view.Messages" field="messages" />

    <ui:with type="com.sencha.gxt.widget.core.client.TabItemConfig" field="editorTab">
        <ui:attributes text="{messages.backgroundGraphic_edit}" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.TabItemConfig" field="querierTab">
        <ui:attributes text="{messages.backgroundGraphic_query}" />
    </ui:with>

    <gxt:TabPanel>
        <gxt:child config="{editorTab}">
            <common:BackgroundGraphicEditViewer ui:field="editViewer" />
        </gxt:child>
        <gxt:child config="{querierTab}">
            <common:BackgroundGraphicQueryViewer ui:field="queryViewer" />
        </gxt:child>
    </gxt:TabPanel>
</ui:UiBinder> 
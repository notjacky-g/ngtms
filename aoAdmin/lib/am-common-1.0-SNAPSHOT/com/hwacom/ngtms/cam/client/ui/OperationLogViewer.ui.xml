<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid">

    <ui:with type="com.hwacom.ngtms.cam.view.Messages" field="message" />

    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="listStore" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.ColumnModel"
        field="columnModel" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.GridView"
        field="gridView" />

        <grid:Grid ui:field="grid" store="{listStore}" cm="{columnModel}"
            view="{gridView}" />
</ui:UiBinder> 
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
	xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
	xmlns:toolbar="urn:import:com.sencha.gxt.widget.core.client.toolbar"
	xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button"
	xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid"
	xmlns:common="urn:import:com.hwacom.ngtms.common.am.view"
	xmlns:tree="urn:import:com.sencha.gxt.widget.core.client.tree">

	<ui:import field="com.sencha.gxt.widget.core.client.button.ToolButton.PLUS" />
	<ui:import field="com.sencha.gxt.widget.core.client.button.ToolButton.RIGHT" />
	
	<!-- ToolButton -->
    <ui:import field="com.sencha.gxt.widget.core.client.button.ToolButton.EXPAND" />
	<ui:import field="com.sencha.gxt.widget.core.client.button.ToolButton.COLLAPSE" />
	<ui:with field="expandAllToolTip" type="com.sencha.gxt.widget.core.client.tips.ToolTipConfig">
		<ui:attributes body="全部展開" />
	</ui:with>
	<ui:with field="collapseAllToolTip" type="com.sencha.gxt.widget.core.client.tips.ToolTipConfig">
		<ui:attributes body="全部合起" />
	</ui:with>
	
    <ui:with field="margins4444" type="com.sencha.gxt.core.client.util.Margins">
    	<ui:attributes top="4" right="4" bottom="4" left="4"/>
    </ui:with>
    
    <ui:with field="margins4440" type="com.sencha.gxt.core.client.util.Margins">
    	<ui:attributes top="4" right="4" bottom="4" left="0"/>
    </ui:with>
    
    <ui:with field="margins0004" type="com.sencha.gxt.core.client.util.Margins">
    	<ui:attributes top="0" right="0" bottom="0" left="4"/>
    </ui:with>
    
    <ui:with field="leftHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
		<ui:attributes margins="{margins4444}" height="1" width="1"/>
    </ui:with>
    <ui:with field="centerHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
		<ui:attributes margins="{margins4444}" height="1" width="350"/>
    </ui:with>
    <ui:with field="rightHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
		<ui:attributes margins="{margins4444}" height="1" width="310"/>
    </ui:with>

    <ui:with field="queryHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
		<ui:attributes margins="{margins4444}" height="1" width="150"/>
    </ui:with>

	<ui:with field="horizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins4444}" height="30" width="-1"/>
    </ui:with>
    <ui:with field="dateHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins4440}" height="30" width="95"/>
    </ui:with>
    <ui:with field="timeHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins4440}" height="30" width="65"/>
    </ui:with>
    <ui:with field="returnTimeHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins4440}" height="30" width="65"/>
    </ui:with>
    <ui:with field="waveHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins4444}" height="30" width="10"/>
    </ui:with>
    
	<ui:with field="gridlLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
    	<ui:attributes margins="{margins4444}" height="1" width="1"/>
    </ui:with>

	<ui:with field="queryVerticalLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
    	<ui:attributes margins="{margins4444}" height="35" width="1"/>
    </ui:with>

    <ui:with field="verticalLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
    	<ui:attributes margins="{margins4444}" height="30" width="300"/>
    </ui:with>
    <ui:with field="verticalLayoutData2" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
    	<ui:attributes margins="{margins0004}" height="30" width="300"/>
    </ui:with>
    <ui:with field="timeVerticalLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
    	<ui:attributes margins="{margins0004}" height="60" width="300"/>
    </ui:with>
    <ui:with field="gridVerticalLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
    	<ui:attributes margins="{margins0004}" height="1" width="1"/>
    </ui:with>
    
   	<ui:with field="treeVerticalLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
   		<ui:attributes margins="{margins0004}" height="1" width="1"/>
   	</ui:with>
    
    <ui:with field="listStore" type="com.sencha.gxt.data.shared.ListStore"/>
    <ui:with field="columnModel" type="com.sencha.gxt.widget.core.client.grid.ColumnModel"/>
    <ui:with field="gridView" type="com.sencha.gxt.widget.core.client.grid.GridView">
    	<ui:attributes stripeRows="true" forceFit="true"/>
    </ui:with>
    
    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="queryCardTypeCbStore" />
    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="queryCardTypeCbLabelProvider" />

    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="queryIssueCbStore"/>
    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="queryIssueCbLabelProvider"/>

    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="cardTypeCbStore" />
    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="cardTypeCbLabelProvider" />
    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="cardGroupCbStore" />
    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="cardGroupCbLabelProvider" />
    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="cardStatusCbStore" />
    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="cardStatusCbLabelProvider" />
    
    <ui:with type="com.sencha.gxt.data.shared.TreeStore" field="treeStore" />
    <ui:with type="com.sencha.gxt.core.client.ValueProvider" field="treeValueProvider" />
    
    <container:HorizontalLayoutContainer>
		<container:child layoutData="{leftHorizontalLayoutData}">
			<gxt:ContentPanel headerVisible="false">
				<container:VerticalLayoutContainer>
					<container:child layoutData="{queryVerticalLayoutData}">
						<toolbar:ToolBar>
								<form:FieldLabel text="卡片編號"
												 labelWidth="60">
									<form:widget>
										<form:TextField ui:field="queryAba"/>
									</form:widget>
								</form:FieldLabel>
								<form:FieldLabel text="卡片種類"
												 labelWidth="60">
								<form:widget>
									<form:ComboBox ui:field="queryCardTypeComboBox"
			                                       store="{queryCardTypeCbStore}"
			                                       labelProvider="{queryCardTypeCbLabelProvider}"
			                                                   triggerAction="ALL"
			                                                   editable="false" />
									</form:widget>
								</form:FieldLabel>
								<form:FieldLabel text="是否發卡"
												 labelWidth="60">
									<form:widget>
										<form:ComboBox ui:field="queryIssueComboBox"
	                                                   store="{queryIssueCbStore}"
	                                                   labelProvider="{queryIssueCbLabelProvider}"
	                                                   triggerAction="ALL"
	                                                   editable="false" />
									</form:widget>
								</form:FieldLabel>
								
								<toolbar:FillToolItem />
								
								<button:ToolButton ui:field="createCard"
												   config="{PLUS}" 
												   toolTip="新增卡片"/>
								
						</toolbar:ToolBar>
					</container:child>
					<container:child layoutData="{gridVerticalLayoutData}">
						<grid:Grid ui:field="grid"
								   store="{listStore}"
								   cm="{columnModel}"
								   view="{gridView}"
								   borders="true"
								   />
					</container:child>
				</container:VerticalLayoutContainer>
			</gxt:ContentPanel>
		</container:child>
		<container:child layoutData="{centerHorizontalLayoutData}">
			<gxt:ContentPanel heading="基本資料設定">
				<container:VerticalLayoutContainer scrollMode="AUTO">
					<!-- TODO 卡片基本設定 -->
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="卡片編號"
										 labelWidth="105">
							<form:widget>
								<g:Label ui:field="aba" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="是否已發卡"
										 labelWidth="105">
							<form:widget>
								<g:Label ui:field="issued" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="卡片種類"
										 labelWidth="105">
							<form:widget>
								<form:ComboBox ui:field="cardTypeComboBox"
                                                     store="{cardTypeCbStore}"
                                                     labelProvider="{cardTypeCbLabelProvider}"
                                                     triggerAction="ALL"
                                                     editable="false" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="定期卡群組"
										 labelWidth="105">
							<form:widget>
								<form:ComboBox ui:field="cardGroupComboBox"
                                                     store="{cardGroupCbStore}"
                                                     labelProvider="{cardGroupCbLabelProvider}"
                                                     triggerAction="ALL"
                                                     editable="false" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="卡片狀態"
										 labelWidth="105">
							<form:widget>
								<form:ComboBox ui:field="cardStatusComboBox"
                                                     store="{cardStatusCbStore}"
                                                     labelProvider="{cardStatusCbLabelProvider}"
                                                     triggerAction="ALL"
                                                     editable="false" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="姓名"
										 labelWidth="105">
							<form:widget>
								<form:TextField ui:field="name"/>
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="身分證號碼"
										 labelWidth="105">
							<form:widget>
								<form:TextField ui:field="idNo"/>
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="公司"
										 labelWidth="105">
							<form:widget>
								<form:TextField ui:field="company"/>
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="員工編號"
										 labelWidth="105">
							<form:widget>
								<form:TextField ui:field="employeeNo"/>
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="職稱"
										 labelWidth="105">
							<form:widget>
								<form:TextField ui:field="jobTitle"/>
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="電話"
										 labelWidth="105">
							<form:widget>
								<form:TextField ui:field="tel"/>
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="手機"
										 labelWidth="105">
							<form:widget>
								<form:TextField ui:field="mobile"/>
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="角色編號"
										 labelWidth="105">
							<form:widget>
								<form:TextField ui:field="roleId"/>
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{timeVerticalLayoutData}">
						<form:FieldLabel text ="磁卡有效日期"
                                        labelWidth="105"
                                        width="210">
                           <form:widget>
                           		<container:VerticalLayoutContainer>
                           			<container:child layoutData="{verticalLayoutData2}">
		                           		<container:HorizontalLayoutContainer>
			                                       <container:child layoutData="{dateHorizontalLayoutData}">
			                                           <form:DateField ui:field="startDate"
			                                                           width="110"/>
			                                       </container:child>
			                                       <container:child layoutData="{waveHorizontalLayoutData}">
			                                           <g:Label text =" ~ "/>
			                                       </container:child>
		                            	</container:HorizontalLayoutContainer>
		                            </container:child>
		                            <container:child layoutData="{verticalLayoutData2}">
		                            	<container:HorizontalLayoutContainer>
	                                           <container:child layoutData="{dateHorizontalLayoutData}">
			                                           <form:DateField ui:field="endDate"
			                                                           width="110"/>
			                                    </container:child>
			                             </container:HorizontalLayoutContainer>
                                   	</container:child>
	                            </container:VerticalLayoutContainer>
                           </form:widget>
                       </form:FieldLabel>
					</container:child>
					<container:child layoutData="{timeVerticalLayoutData}">
						<form:FieldLabel text ="實際可進機房日期"
                                         labelWidth="105"
                                         width="210">
                            <form:widget>
	                           	<container:VerticalLayoutContainer>
                           			<container:child layoutData="{verticalLayoutData2}">
		                           		<container:HorizontalLayoutContainer>
			                                       <container:child layoutData="{dateHorizontalLayoutData}">
			                                           <form:DateField ui:field="actualStartDate"
			                                                           width="110"/>
			                                       </container:child>
			                                       <container:child layoutData="{timeHorizontalLayoutData}">
			                                           <form:TimeField ui:field="actualStartTime"
			                                                            allowBlank="true"
			                                                            triggerAction="ALL"
			                                                            increment="60"
			                                                            width="80"/>
			                                       </container:child>
			                                       <container:child layoutData="{waveHorizontalLayoutData}">
			                                           <g:Label text =" ~ "/>
			                                   	   </container:child>
		                            	</container:HorizontalLayoutContainer>
		                            </container:child>
		                            <container:child layoutData="{verticalLayoutData2}">
		                            	<container:HorizontalLayoutContainer>
	                                           <container:child layoutData="{dateHorizontalLayoutData}">
			                                           <form:DateField ui:field="actualEndDate"
			                                                           width="110"/>
			                                    </container:child>
			                                    <container:child layoutData="{timeHorizontalLayoutData}">
			                                           <form:TimeField ui:field="actualEndTime"
			                                                            allowBlank="true"
			                                                            triggerAction="ALL"
			                                                            increment="60"
			                                                            width="80"/>
			                                    </container:child>
			                             </container:HorizontalLayoutContainer>
                                   	</container:child>
	                            </container:VerticalLayoutContainer>
                            </form:widget>
                        </form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData2}">
						<form:FieldLabel text ="預計歸還日期"
                                        labelWidth="105"
                                        width="210">
                           <form:widget>
                           		<container:HorizontalLayoutContainer>
                         			  <container:child layoutData="{dateHorizontalLayoutData}">
	                                           <form:DateField ui:field="expectedReturnDate"
	                                                           width="110"/>
	                                  </container:child>
                                      <container:child layoutData="{returnTimeHorizontalLayoutData}">
                                             <form:TimeField ui:field="expectedReturnTime"
                                                allowBlank="true"
                                                triggerAction="ALL"
                                                increment="60"
                                                width="80"/>
                                      </container:child>
                            	</container:HorizontalLayoutContainer>
                           </form:widget>
                       </form:FieldLabel>
					</container:child>
					<container:child layoutData="{verticalLayoutData2}">
						<form:FieldLabel text ="實際歸還日期"
                                        labelWidth="105"
                                        width="210">
                           <form:widget>
                           		<container:HorizontalLayoutContainer>
                           			<container:child layoutData="{dateHorizontalLayoutData}">
	                                		<form:DateField ui:field="returnDate"
	                                                           width="110"/>
	                                </container:child>
                                    <container:child layoutData="{returnTimeHorizontalLayoutData}">
                                            <form:TimeField ui:field="returnTime"
                                               allowBlank="true"
                                               triggerAction="ALL"
                                               increment="60"
                                               width="80"/>
                                     </container:child>
                            	</container:HorizontalLayoutContainer>
                           </form:widget>
                       </form:FieldLabel>
					</container:child>
					
					<container:child layoutData="{verticalLayoutData}">
						<form:FieldLabel text="備註"
										 labelWidth="105">
							<form:widget>
								<form:TextField ui:field="memo"/>
							</form:widget>
						</form:FieldLabel>
					</container:child>
				</container:VerticalLayoutContainer>
			</gxt:ContentPanel>
    	</container:child>
    	<container:child layoutData="{rightHorizontalLayoutData}">
			<gxt:ContentPanel heading="權限設定">
				<gxt:tool>
					<button:ToolButton ui:field="expandAll"
									   config="{EXPAND}"
		                               toolTipConfig="{expandAllToolTip}" />
		        </gxt:tool>
				<gxt:tool>
					<button:ToolButton ui:field="collapseAll"
		                               config="{COLLAPSE}"
		                               toolTipConfig="{collapseAllToolTip}" />
				</gxt:tool>
				<container:VerticalLayoutContainer>
				<!-- TODO 機房權限checkBox tree -->
					<container:child layoutData="{treeVerticalLayoutData}">
	    				<tree:Tree ui:field="tree" 
	    						   valueProvider="{treeValueProvider}"
	    						   autoExpand="true"
	    				   		   store="{treeStore}"/>
    				</container:child>
				</container:VerticalLayoutContainer>
				<gxt:button>
					<button:TextButton ui:field="issueImmediately" text="立即發卡"/>
				</gxt:button>
				<gxt:button>
					<button:TextButton ui:field="issue" text="發卡"/>
				</gxt:button>
				<gxt:button>
					<button:TextButton ui:field="modify" text="修改"/>
				</gxt:button>
			</gxt:ContentPanel>
    	</container:child>
    </container:HorizontalLayoutContainer>
</ui:UiBinder> 
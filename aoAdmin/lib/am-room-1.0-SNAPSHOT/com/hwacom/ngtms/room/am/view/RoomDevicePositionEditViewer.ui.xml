<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
             xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
             xmlns:am="urn:import:com.hwacom.ngtms.cam.client.ui"
             xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
             xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
             xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button">

	<ui:with field="messages" type="com.hwacom.ngtms.room.am.view.Messages" />
    <ui:with field="allImages" type="com.hwacom.ngtms.room.am.images.AllImages" />

	<ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4444">
        <ui:attributes top="4" right="4" bottom="4" left="4" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4440">
        <ui:attributes top="4" right="4" bottom="4" left="0" />
    </ui:with>

    <ui:with field="westLayoutData" type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData">
        <ui:attributes size="270" collapsible="true" split="true" margins="{margins4444}" />
    </ui:with>
    <ui:with field="centerLayoutData" type="com.sencha.gxt.widget.core.client.container.MarginData">
        <ui:attributes margins="{margins4440}" />
    </ui:with>
    
    <ui:with field="verLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes margins="{margins4444}" />
    </ui:with>

	<ui:with type="com.sencha.gxt.data.shared.ListStore" field="layerListStore" />
    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="layerLabelProvider" />

    <container:BorderLayoutContainer>
    	<container:west layoutData="{westLayoutData}">
    		<gxt:ContentPanel heading="各機房設備位置設定">
    			<container:VerticalLayoutContainer>
    				<container:child layoutData="{verLayoutData}">
    					<form:FieldLabel text="選擇機房位置">
		    				<form:widget>
		    					<form:ComboBox ui:field="layerComboBox"
		    								   store="{layerListStore}"
		                                       labelProvider="{layerLabelProvider}"
		                            		   editable="false"
		                            		   triggerAction="ALL" />
		    				</form:widget>
		    			</form:FieldLabel>
    				</container:child>
    			</container:VerticalLayoutContainer>
    			<gxt:button>
                    <button:TextButton ui:field="saveButton" text="{messages.button_save}" />
                </gxt:button>
    		</gxt:ContentPanel>
    	</container:west>
        <container:center layoutData="{centerLayoutData}">
        	<container:VerticalLayoutContainer scrollMode="AUTO">
        		<container:child>
        			<gxt:ContentPanel ui:field="aboveSvgContainer" heading="所選機房及樓層">	
        				<gxt:ContentPanel ui:field="svgContainer" headerVisible="false"/>
        			</gxt:ContentPanel>
        		</container:child>
        	</container:VerticalLayoutContainer>
        </container:center>
    </container:BorderLayoutContainer>
</ui:UiBinder>
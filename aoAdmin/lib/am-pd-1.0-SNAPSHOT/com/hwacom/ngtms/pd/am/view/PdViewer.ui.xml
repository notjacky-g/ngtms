<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:am="urn:import:com.hwacom.ngtms.cam.client.ui"
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button"
    xmlns:pd="urn:import:com.hwacom.ngtms.pd.am.view">

    <ui:with field="messages" type="com.hwacom.ngtms.pd.am.view.Messages" />
    <ui:with field="allImages" type="com.hwacom.ngtms.pd.am.images.AllImages" />

	<!-- Layout Data -->
    <ui:with field="margin4444" type="com.sencha.gxt.core.client.util.Margins">
        <ui:attributes top="4" right="4" bottom="4" left="4" />
    </ui:with>
    <ui:with field="centerMargins" type="com.sencha.gxt.core.client.util.Margins">
        <ui:attributes top="4" right="4" bottom="4" left="0" />
    </ui:with>

    <ui:with type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData" field="northLayoutData">
        <ui:attributes size="70" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.container.MarginData" field="centerLayoutData">
        <ui:attributes margins="{centerMargins}" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData" field="opLogLayoutData">
        <ui:attributes size="200" collapsible="true" split="true" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData" field="roadTreeViewLayoutData">
        <ui:attributes width="1" height="1" />
    </ui:with>
	
    <ui:import field="com.sencha.gxt.widget.core.client.button.ToolButton.QUESTION" />

    <container:BorderLayoutContainer>
        <container:north layoutData="{northLayoutData}">
            <am:TitleViewer itemImage="{allImages.titleItem}"
                          	itemName="{messages.pd}" />
        </container:north>
        <container:center>
            <am:AmTabPanel ui:field="amTabPanel" dndType="DeviceConfig">
                <am:item>
                    <pd:PdConfigSettingViewer ui:field="pdConfigSetting"
                                                  tabTitle="{messages.pdConfigSetting}" />
                </am:item>
                 <am:item>
                    <pd:PdLoopDeviceConfigSettingViewer ui:field="pdLoopDeviceConfigSetting"
                                                  tabTitle="{messages.pdLoopDeviceConfigSetting}" />
                </am:item>
                 <am:item>
                    <pd:PdStatusViewer ui:field="pdStatusViewer"
                                                  tabTitle="{messages.pdStatus}" />
                </am:item>             
            </am:AmTabPanel>
       </container:center>
    </container:BorderLayoutContainer>
</ui:UiBinder>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid"
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:tree="urn:import:com.sencha.gxt.widget.core.client.tree"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
    xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button">
    
    <ui:with field="messages" type="com.hwacom.ngtms.pd.am.view.Messages" />

    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4444">
        <ui:attributes top="4" right="4" bottom="4" left="4" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4440">
        <ui:attributes top="4" right="4" bottom="4" left="0" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4224">
        <ui:attributes top="4" right="2" bottom="2" left="4" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins01500">
        <ui:attributes top="0" right="20" bottom="0" left="0" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins0204">
        <ui:attributes top="0" right="2" bottom="0" left="4" />
    </ui:with>

    <ui:with type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData" field="eastLayoutData">
        <ui:attributes size="250" margins="{margins4444}" collapsible="true" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.container.MarginData" field="centerLayoutData">
        <ui:attributes margins="{margins4440}" />
    </ui:with>
    <ui:with field="itemData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes width="1" height="30" margins="{margins4224}" />
    </ui:with>
    <ui:with field="itemValueData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="1" height="1" margins="{margins01500}" />
    </ui:with>
    <ui:with field="milepostData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="25" height="30" margins="{margins4224}" />
    </ui:with>
    <ui:with field="meterData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="70" height="30" margins="{margins0204}" />
    </ui:with>

    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="listStore" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.ColumnModel" field="columnModel" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.GridView" field="gridView">
        <ui:attributes stripeRows="true" />
    </ui:with>
    
    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="directionStore" />
    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="directionProvider" />
    
    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="locationStore" />
    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="locationProvider" />
    
    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="lineStore" />
    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="lineProvider" />
    
    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="sectionStore" />
    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="sectionProvider" />
    
     <container:BorderLayoutContainer>
        <container:center layoutData="{centerLayoutData}">
            <grid:Grid ui:field="grid"
                       store="{listStore}"
                       cm="{columnModel}"
                       view="{gridView}" />
        </container:center>
        <container:east layoutData="{eastLayoutData}">
           <gxt:ContentPanel heading="{messages.pdConfigSettingViewer_deviceSetting}">
           <container:VerticalLayoutContainer scrollMode="AUTOY">
            <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_deviceName}" 
        				 	 labelWidth="80">
        		 <form:widget>
        		   <form:TextField ui:field="deviceName"
        							layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_displayName}" 
        				 	 labelWidth="80">
        		 <form:widget>
        		   <form:TextField ui:field="displayName"
        							layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_locationNo}" 
        				 	 labelWidth="80">
        		 <form:widget>
                    <form:ComboBox ui:field="location"
                                   store="{locationStore}"
                                   layoutData="{itemValueData}"
                                   labelProvider="{locationProvider}"
                                   triggerAction="ALL" 
                                   editable="false"/>
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_lineId}" 
        				 	 labelWidth="80">
        		 <form:widget>
                    <form:ComboBox ui:field="line"
                                   store="{lineStore}"
                                   layoutData="{itemValueData}"
                                   labelProvider="{lineProvider}"
                                   triggerAction="ALL" 
                                   editable="false"/>
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_direction}" 
        				 	 labelWidth="80">
        		 <form:widget>
                    <form:ComboBox ui:field="direction"
                                   store="{directionStore}"
                                   layoutData="{itemValueData}"
                                   labelProvider="{directionProvider}"
                                   triggerAction="ALL" 
                                   editable="false"/>
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		  <container:child layoutData="{itemData}">
       		  	<container:HorizontalLayoutContainer>
       		 	  <container:child>
        	   		<form:FieldLabel text="{messages.column_pdConfig_milepost}" 
        				 	 		 labelWidth="80">
        		 		<form:widget>
        		    		<form:IntegerField ui:field="kilometer"
        							  		   height="1"
        							  		   width="45"
        							           enabled="true"
        							           allowBlank="false" />
        		 		</form:widget>
        	   	    </form:FieldLabel>
        	   	 </container:child>
        	     <container:child layoutData="{milepostData}">
        	  	   	<g:Label text="k+" />
        	  	  </container:child>
        	  	  <container:child layoutData="{meterData}">
        		   		<form:IntegerField ui:field="meter"
        							       height="1"
        							  	   width="60"
        							  	   enabled="true"
        							  	   allowBlank="false" />
        	    </container:child>
        	   </container:HorizontalLayoutContainer>  
       		 </container:child> 
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_section}" 
        				 	 labelWidth="80">
        		 <form:widget>
                    <form:ComboBox ui:field="section"
                                   store="{sectionStore}"
                                   layoutData="{itemValueData}"
                                   labelProvider="{sectionProvider}"
                                   triggerAction="ALL" 
                                   editable="false"/>
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_meterNo}" 
        				 	 labelWidth="80">
        		 <form:widget>
        		   <form:TextField ui:field="meterNo"
        							layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="true" />
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_area}" 
        				 	 labelWidth="80">
        		 <form:widget>
        		   <form:TextField ui:field="area"
        							layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="true" />
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child> 
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_phone}" 
        				 	 labelWidth="80">
        		 <form:widget>
        		   <form:TextField ui:field="phone"
        							layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="true" />
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_ip}" 
        				 	 labelWidth="80">
        		 <form:widget>
        		   <form:TextField ui:field="ip"
        							layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_port}" 
        				 	 labelWidth="80">
        		 <form:widget>
        		   <form:IntegerField ui:field="port"
        							layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child> 
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_longitude}" 
        				 	 labelWidth="80">
        		 <form:widget>
        		   <form:DoubleField ui:field="longitude"
        							 layoutData="{itemValueData}"
        							 enabled="true"
        							 allowBlank="true" />
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_latitude}" 
        				 	 labelWidth="80">
        		 <form:widget>
        		   <form:DoubleField ui:field="latitude"
        							 layoutData="{itemValueData}"
        							 enabled="true"
        							 allowBlank="true" />
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_loopNo}" 
        				 	 labelWidth="80">
        		 <form:widget>
        		   <form:IntegerField ui:field="loopNo"
        							layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="false" />
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_memo}" 
        				 	 labelWidth="80">
        		 <form:widget>
        		   <form:TextField ui:field="memo"
        							layoutData="{itemValueData}"
        							enabled="true"
        							allowBlank="true" />
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>
       		 <container:child layoutData="{itemData}">
        	   <form:FieldLabel text="{messages.column_pdConfig_enable}" 
        				 	 labelWidth="80">
        		 <form:widget>
                    <form:SimpleComboBox ui:field="enable"
                                   layoutData="{itemValueData}"
                                   triggerAction="ALL" 
                                   editable="false"/>
        		 </form:widget>
        	   </form:FieldLabel>
       		 </container:child>   		    		    		 		 
           </container:VerticalLayoutContainer>
             <gxt:button>
                 <button:TextButton ui:field="save"
                                    text="新增"/>
             </gxt:button>
             <gxt:button>                           
                 <button:TextButton ui:field="update"
                                    text="修改"/>
             </gxt:button>
             <gxt:button>                    
                 <button:TextButton ui:field="delete"
                                    text="刪除"/>
            </gxt:button>  
           </gxt:ContentPanel>
        </container:east>
    </container:BorderLayoutContainer>
</ui:UiBinder> 
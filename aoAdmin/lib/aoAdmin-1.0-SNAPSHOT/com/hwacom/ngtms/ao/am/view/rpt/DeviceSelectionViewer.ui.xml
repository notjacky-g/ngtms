<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:core="urn:import:com.sencha.gxt.widget.core.client"
             xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid">

    <!-- I18N、Resource -->
    <ui:with field="messages" type="com.hwacom.ngtms.ao.am.view.Messages" />
    <!-- ======== -->

    <!-- 其他 import / with -->
    <ui:with field="cm" type="com.sencha.gxt.widget.core.client.grid.ColumnModel" />
    <ui:with field="store" type="com.sencha.gxt.data.shared.ListStore" />
    <ui:with field="view" type="com.sencha.gxt.widget.core.client.grid.GridView">
        <ui:attributes forceFit="true" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.menu.MenuItem" field="menuItemDelete">
        <ui:attributes text="{messages.menuItem_text_delete}" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.menu.Menu" field="contextMenu" />
    <!-- ==== -->

    <grid:Grid ui:field="grid" cm="{cm}" store="{store}" view="{view}" />
</ui:UiBinder> 
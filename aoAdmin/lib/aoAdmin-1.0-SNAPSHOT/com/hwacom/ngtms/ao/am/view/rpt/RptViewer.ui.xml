<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client" 
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
    xmlns:am="urn:import:com.hwacom.ngtms.cam.client.ui"
    xmlns:view="urn:import:com.hwacom.ngtms.ao.am.view"
    xmlns:common="urn:import:com.hwacom.ngtms.common.am.view">
    
    <!-- I18N、Resource -->
    <ui:with field="messages" type="com.hwacom.ngtms.ao.am.view.Messages" />
    <ui:with field="allImages" type="com.hwacom.ngtms.ao.am.images.AllImages" />
    <!-- ======== -->

    <!-- Margin 設定區 -->
    <ui:with field="centerMargins" type="com.sencha.gxt.core.client.util.Margins">
        <ui:attributes top="4" right="0" bottom="0" left="0" />
    </ui:with>
    <!-- ==== -->

    <!-- Layout Data 區 -->
    <ui:with field="northLayoutData" type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData">
        <ui:attributes size="70" />
    </ui:with>
    <ui:with field="centerLayoutData" type="com.sencha.gxt.widget.core.client.container.MarginData">
        <ui:attributes margins="{centerMargins}" />
    </ui:with>
    <!-- ======== -->

    <!-- 其他 import / with -->
    <ui:with field="reportGenerationConfig" type="com.sencha.gxt.widget.core.client.TabItemConfig">
        <ui:attributes text="{messages.tab_reportGeneration}" />
    </ui:with>
    <ui:with field="reportBatchPrintConfig" type="com.sencha.gxt.widget.core.client.TabItemConfig">
        <ui:attributes text="{messages.tab_reportBatchPrint}" />
    </ui:with>
    <!-- ======== -->

    <!-- I18N -->
    <container:BorderLayoutContainer borders="false">
        <container:north layoutData="{northLayoutData}">
            <view:TitleViewer />
        </container:north>
        <container:center layoutData="{centerLayoutData}">
        	<common:ReportViewer module="AO" exportXls="true" />
        </container:center>
    </container:BorderLayoutContainer>
</ui:UiBinder>
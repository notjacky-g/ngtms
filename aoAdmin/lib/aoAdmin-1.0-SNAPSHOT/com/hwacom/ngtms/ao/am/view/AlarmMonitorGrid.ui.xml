<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container">
    
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins2222">
        <ui:attributes top="2" right="2" bottom="2" left="2" />
    </ui:with>
    
    <ui:with field="vContainerData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes width="1" height="720" margins="{margins2222}" />
    </ui:with>

    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="listStore" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.ColumnModel" field="columnModel" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.GridView" field="alarmGridView">
        <ui:attributes stripeRows="true" forceFit="true" />
    </ui:with>
	
	<container:VerticalLayoutContainer scrollMode="AUTOY">
		<container:child layoutData ="{vContainerData}"> 
		 	<grid:Grid ui:field="alarmGrid" store="{listStore}" cm="{columnModel}" view="{alarmGridView}" />
		</container:child> 
	</container:VerticalLayoutContainer>
</ui:UiBinder> 
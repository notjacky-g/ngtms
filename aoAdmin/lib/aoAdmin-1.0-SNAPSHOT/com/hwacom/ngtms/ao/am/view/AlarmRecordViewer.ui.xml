<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
	xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
	xmlns:c="urn:import:com.sencha.gxt.widget.core.client"
	xmlns:toolbar="urn:import:com.sencha.gxt.widget.core.client.toolbar"
	xmlns:amc="urn:import:com.hwacom.ngtms.cam.client.ui.component"
	xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid"
	xmlns:view="urn:import:com.hwacom.ngtms.ao.am.view"
	xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
	xmlns:am="urn:import:com.hwacom.ngtms.cam.client.ui"
	xmlns:amComponent="urn:import:com.hwacom.ngtms.cam.client.ui.component"
	xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button"
	xmlns:common="urn:import:com.hwacom.ngtms.common.am.view">
	
	
	<ui:with field="messages" type="com.hwacom.ngtms.ao.am.view.Messages" />

	<ui:with type="com.sencha.gxt.core.client.util.Margins" field="westMargins">
		<ui:attributes top="4" right="4" bottom="4" left="4" />
	</ui:with>
	<ui:with type="com.sencha.gxt.core.client.util.Margins" field="centerMargins">
		<ui:attributes top="4" right="4" bottom="4" left="0" />
	</ui:with>
	<ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4444">
		<ui:attributes top="4" right="4" bottom="4" left="4" />
	</ui:with>
	<ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins03000">
		<ui:attributes top="0" right="30" bottom="0" left="0" />
	</ui:with>

	<ui:with field="centerData" type="com.sencha.gxt.widget.core.client.container.MarginData">
		<ui:attributes margins="{centerMargins}" />
	</ui:with>
	<ui:with field="westData" type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData">
		<ui:attributes size="320" margins="{westMargins}" collapsible="true" split="true" />
	</ui:with>
	<ui:with field="topData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
		<ui:attributes width="1" height="30" />
	</ui:with>
	<ui:with field="gridData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
		<ui:attributes width="1" height="1" />
	</ui:with>
	<ui:with field="dataRowData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
		<ui:attributes width="1" height="30" margins="{margins4444}" />
	</ui:with>
	<ui:with field="gridBottomData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
		<ui:attributes width="1" />
	</ui:with>
	<ui:with field="hLayoutData1" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
		<ui:attributes margins="{margins03000}" />
	</ui:with>
	
	<ui:with field="store" type="com.sencha.gxt.data.shared.ListStore" />
	<ui:with field="cm" type="com.sencha.gxt.widget.core.client.grid.ColumnModel" />
	<ui:with field="view" type="com.sencha.gxt.widget.core.client.grid.GridView">
		<ui:attributes stripeRows="true" forceFit="true"/>
	</ui:with>

	<container:BorderLayoutContainer ui:field="borderLayoutContainer" borders="true">
		<container:west layoutData="{westData}">
			<c:ContentPanel heading="{messages.alarmLog_queryTitle}"
							buttonAlign="CENTER">
				<container:VerticalLayoutContainer>
					<container:child layoutData="{dataRowData}">
						<container:HorizontalLayoutContainer>
							<container:child layoutData="{hLayoutData1}">
								<toolbar:LabelToolItem label="{messages.dateRangePicker}" />
							</container:child>
							<container:child>
								<common:DateRangePicker ui:field="dateRangePicker" 
												timePicker="true" 
												singleDatePicker="false" />
							</container:child>
						</container:HorizontalLayoutContainer>
					</container:child>
					<container:child layoutData="{dataRowData}">
						<form:FieldLabel text="機房">
							<form:widget>
								<form:SimpleComboBox ui:field="ncuComboBox"
											  		 editable="false"
											   	   	 triggerAction="ALL" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
					<container:child layoutData="{dataRowData}">
						<form:FieldLabel text="告警種類">
							<form:widget>
								<form:SimpleComboBox ui:field="alarmMonitorTypeCombo"
											   		 editable="false"
											   		 triggerAction="ALL" />
							</form:widget>
						</form:FieldLabel>
					</container:child>
				</container:VerticalLayoutContainer>
				<c:button>
					<button:TextButton ui:field="queryButton"
									   text="{messages.alarmLog_queryButton}" />
				</c:button>
			</c:ContentPanel>
		</container:west>
		<container:center layoutData="{centerData}">
			<container:CardLayoutContainer ui:field="cardLayout">
				<gxt:ContentPanel headerVisible="false"
								  buttonAlign="CENTER">
					<container:VerticalLayoutContainer>
						<container:child layoutData="{topData}">
							<toolbar:ToolBar>
								<toolbar:FillToolItem />
								<toolbar:LabelToolItem label="{messages.alarmLog_queryData}" width="150" />
								<toolbar:FillToolItem />
								<button:TextButton ui:field="exportButton"
												   width="50"
												   text="{messages.export}" />
							</toolbar:ToolBar>
						</container:child>
						<container:child layoutData="{gridData}">
							<grid:Grid ui:field="grid"
									   store="{store}"
									   cm="{cm}"
									   view="{view}"
									   borders="false"
									   columnReordering="true"
									   stateful="true" />
						</container:child>
						<container:child layoutData="{gridBottomData}">
							<toolbar:PagingToolBar ui:field="pageToolBar"
												   pageSize="50" 
												   borders="false" />
						</container:child>
					</container:VerticalLayoutContainer>
				</gxt:ContentPanel>
			</container:CardLayoutContainer>
		</container:center>
	</container:BorderLayoutContainer>
</ui:UiBinder> 
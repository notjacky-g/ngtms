<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
    xmlns:am="urn:import:com.hwacom.ngtms.cam.client.ui"
    xmlns:rpt="urn:import:com.hwacom.ngtms.ao.am.view.rpt"
    xmlns:common="urn:import:com.hwacom.ngtms.common.am.view">

    <!-- I18N、Resource -->
    <ui:with field="messages" type="com.hwacom.ngtms.ao.am.view.Messages" />
    <!-- ======== -->

    <!-- Margin 設定區 -->
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins_10">
        <ui:attributes top="10" right="10" bottom="10" left="10" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins_left">
        <ui:attributes top="5" right="0" bottom="0" left="10" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins_0000">
        <ui:attributes top="5" right="0" bottom="0" left="0" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins_00010">
        <ui:attributes top="0" right="0" bottom="0" left="10" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4444">
        <ui:attributes top="4" right="4" bottom="4" left="4" />
    </ui:with> 
    <!-- ======== -->

    <!-- Layout Data 區 -->
    <ui:with field="deviceHLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="740" height="230" />
    </ui:with>
    <ui:with field="rightHLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="740" height="300" />
    </ui:with>
    <ui:with field="fieldHLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="740" height="90" />
    </ui:with>
    <ui:with field="deviceSelectHLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="360" height="200" margins="{margins_10}" />
    </ui:with>
    <ui:with field="timeHLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="200" height="200" margins="{margins_left}"/>
    </ui:with>    
    <ui:with field="time1RowVLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes width="300" height="30" />
    </ui:with>
    <ui:with field="labelVLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes margins="{margins_left}" height="30"/>
    </ui:with>
    <ui:with field="conditionHLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins_0000}" height="30"/>
    </ui:with>
    <ui:with field="labelHLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins_00010}" height="30"/>
    </ui:with>
    <ui:with field="locationVLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes margins="{margins_left}" height="30" />
    </ui:with>
    <ui:with field="horizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins4444}" height="30" width="-1"/>
    </ui:with>
    <ui:with field="deviceVLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes margins="{margins_left}" />
    </ui:with>
    
    <!-- ======== -->
    
    <ui:with field="locationStore" type="com.sencha.gxt.data.shared.ListStore" />
    <ui:with field="locationProvider" type="com.sencha.gxt.data.shared.LabelProvider" /> 
     <ui:with field="deviceTypeStore" type="com.sencha.gxt.data.shared.ListStore" />
    <ui:with field="deviceTypeProvider" type="com.sencha.gxt.data.shared.LabelProvider" /> 
    <ui:with field="signalTypeStore" type="com.sencha.gxt.data.shared.ListStore" />
    <ui:with field="signalTypeProvider" type="com.sencha.gxt.data.shared.LabelProvider" /> 

    <!-- UI Design -->
    <container:HorizontalLayoutContainer>
        <container:VerticalLayoutContainer layoutData="{deviceHLayoutData}">
            <container:child layoutData="{labelVLayoutData}">
               <container:HorizontalLayoutContainer ui:field="locationContainer">
	        	   <form:FieldLabel text="機房名稱"
	        				 	 labelWidth="60">
	        		 <form:widget>
	                    <form:ComboBox ui:field="location"
	                                   store="{locationStore}"
	                                   labelProvider="{locationProvider}"
	                                   width="130"
	                                   triggerAction="ALL" 
	                                   editable="false"/>
	        		 </form:widget>
	        	   </form:FieldLabel>
        	   </container:HorizontalLayoutContainer>
       		 </container:child>
       		 <container:child layoutData="{labelVLayoutData}">
       		   <container:HorizontalLayoutContainer ui:field="statusContainer">
	        	   <form:FieldLabel text="設備種類" 
	        				 	 labelWidth="60">
	        		 <form:widget>
	                    <form:ComboBox ui:field="deviceType"
	                                   store="{deviceTypeStore}"
	                                   labelProvider="{deviceTypeProvider}"
	                                   width="130"
	                                   triggerAction="ALL" 
	                                   editable="false"/>
	        		 </form:widget>
	        	   </form:FieldLabel>
        	   </container:HorizontalLayoutContainer>
       	   </container:child>
       	   <container:child layoutData="{labelVLayoutData}">
       		   <container:HorizontalLayoutContainer ui:field="resultContainer">
	        	   <form:FieldLabel text="訊號種類" 
	        				 	 labelWidth="60">
	        		 <form:widget>
	                    <form:ComboBox ui:field="signalType"
	                                   store="{signalTypeStore}"
	                                   labelProvider="{signalTypeProvider}"
	                                   width="130"
	                                   triggerAction="ALL" 
	                                   editable="false"/>
	        		 </form:widget>
	        	   </form:FieldLabel>
        	   </container:HorizontalLayoutContainer>
       	   </container:child>
        </container:VerticalLayoutContainer>
    </container:HorizontalLayoutContainer>
</ui:UiBinder>
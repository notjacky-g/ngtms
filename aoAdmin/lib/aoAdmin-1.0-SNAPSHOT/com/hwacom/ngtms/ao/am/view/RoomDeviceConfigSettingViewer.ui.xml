<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
             xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
             xmlns:am="urn:import:com.hwacom.ngtms.cam.client.ui"
             xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
             xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid"
             xmlns:tree="urn:import:com.sencha.gxt.widget.core.client.tree"
             xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
             xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with field="messages" type="com.hwacom.ngtms.room.am.view.Messages" />
     <ui:with field="allImages" type="com.hwacom.ngtms.ao.am.images.AllImages" />

	<ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4444">
        <ui:attributes top="4" right="4" bottom="4" left="4" />
    </ui:with>
    
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4040">
        <ui:attributes top="4" right="0" bottom="4" left="0" />
    </ui:with>
    
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins0040">
        <ui:attributes top="0" right="0" bottom="4" left="0" />
    </ui:with>
    
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4044">
        <ui:attributes top="4" right="0" bottom="4" left="4" />
    </ui:with>
    
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4224">
        <ui:attributes top="4" right="2" bottom="2" left="4" />
    </ui:with>

    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins02000">
        <ui:attributes top="0" right="20" bottom="0" left="0" />
    </ui:with>

    <ui:with field="westLayoutData" type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData">
        <ui:attributes size="250" collapsible="true" split="true" margins="{margins4444}" />
    </ui:with>
    
    <ui:with field="eastLayoutData" type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData">
        <ui:attributes size="250" collapsible="true" split="true" margins="{margins4444}" />
    </ui:with>
    
    <ui:with field="centerLayoutData" type="com.sencha.gxt.widget.core.client.container.MarginData">
        <ui:attributes margins="{margins4040}" />
    </ui:with>
    
    <ui:with field="verLayoutData1" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes height="1" margins="{margins0040}" />
    </ui:with>
    
    <ui:with field="verLayoutData2" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes height="1" width="1"/>
    </ui:with>
    
    <ui:with field="itemData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes width="1" height="30" margins="{margins4224}" />
    </ui:with>
    
    <ui:with field="itemValueData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="1" height="1" margins="{margins02000}" />
    </ui:with>

	<ui:with type="com.sencha.gxt.data.shared.ListStore" field="store" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.ColumnModel" field="cm" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.GridView" field="view">
        <ui:attributes stripeRows="true" forceFit="true"/>
    </ui:with>
    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="deviceStore" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.ColumnModel" field="column" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.GridView" field="gridView">
        <ui:attributes stripeRows="true" forceFit="true"/>
    </ui:with>

    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="typeStore" />
    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="typeProvider" />

    <container:BorderLayoutContainer>
    	<container:west layoutData="{westLayoutData}">
    		<gxt:ContentPanel heading="機房樓層">
    			<container:VerticalLayoutContainer>
    				<container:child layoutData="{verLayoutData1}">
		            	<grid:Grid ui:field="grid"
		                       	   store="{store}"
		                           cm="{cm}"
		                           view="{view}" />
    				</container:child>
    			</container:VerticalLayoutContainer>
    		</gxt:ContentPanel>
    	</container:west>
        <container:center layoutData="{centerLayoutData}">
        	<container:VerticalLayoutContainer>
        		<container:child layoutData="{verLayoutData2}">
        			<gxt:ContentPanel heading="設備列表">
        				<grid:Grid ui:field="deviceGrid"
		                       	   store="{deviceStore}"
		                           cm="{column}"
		                           view="{gridView}" />
        			</gxt:ContentPanel>
        		</container:child>
        	</container:VerticalLayoutContainer>
        </container:center>
        <container:east layoutData="{eastLayoutData}">
        	<gxt:ContentPanel heading="監控點設定">
        		 <container:VerticalLayoutContainer scrollMode="AUTOY">
            	 	<container:child layoutData="{itemData}">
        	   			<form:FieldLabel text="監視點名稱" 
        				 	 			 labelWidth="100">
        		 			<form:widget>
        		  				 <form:TextField ui:field="displayName"
        										 layoutData="{itemValueData}"
        							 			 enabled="true"
        									   	 allowBlank="false" />
        		 			</form:widget>
        	   			</form:FieldLabel>
       				 </container:child>
       		 		<container:child layoutData="{itemData}"> 
        	   			<form:FieldLabel text="監視點設備類別" 
        				 	 			 labelWidth="100">
        		 			<form:widget>
                    			<form:ComboBox ui:field="type"
                                  			   store="{typeStore}"
                                   			   layoutData="{itemValueData}"
                                   			   labelProvider="{typeProvider}"
                                   			   triggerAction="ALL" 
                                   			   editable="false"/>
        		 			</form:widget>
        	  		   </form:FieldLabel>
       		 		</container:child>  	
       		 		<container:child layoutData="{itemData}">
        	   			<form:FieldLabel text="單位" 
        				 	 			 labelWidth="100">
        		 			<form:widget>
        		  				 <form:TextField ui:field="unit"
        										 layoutData="{itemValueData}"
        							 			 enabled="true"
        									   	 allowBlank="true" />
        		 			</form:widget>
        	   			</form:FieldLabel>
       				 </container:child>
       				 <container:child layoutData="{itemData}">
        	   			<form:FieldLabel text="上限值" 
        				 	 			 labelWidth="100">
        		 			<form:widget>
        		  				 <form:IntegerField ui:field="upperLimit"
        										 layoutData="{itemValueData}"
        							 			 enabled="true"
        									   	 allowBlank="true" />
        		 			</form:widget>
        	   			</form:FieldLabel>
       				 </container:child>
       				 <container:child layoutData="{itemData}">
        	   			<form:FieldLabel text="下限值" 
        				 	 			 labelWidth="100">
        		 			<form:widget>
        		  				 <form:IntegerField ui:field="lowerLimit"
        										    layoutData="{itemValueData}"
        							 			    enabled="true"
        									   	    allowBlank="true" />
        		 			</form:widget>
        	   			</form:FieldLabel>
       				 </container:child>
       				 <container:child layoutData="{itemData}">
        	   			<form:FieldLabel text="是否發出警報" 
        				 	 			 labelWidth="100">
        		 			<form:widget>
                    			<form:SimpleComboBox ui:field="enable"
                                   					 layoutData="{itemValueData}"
                                  					 triggerAction="ALL" 
                                  				     editable="false"/>
        		 			</form:widget>
        	  		   </form:FieldLabel>
       		 		</container:child>
        		 </container:VerticalLayoutContainer>
        		<gxt:button>
                    <button:TextButton ui:field="saveButton" text="{messages.button_save}" />
                </gxt:button>
        	</gxt:ContentPanel>
        </container:east>
    </container:BorderLayoutContainer>
</ui:UiBinder>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
	xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
	xmlns:toolbar="urn:import:com.sencha.gxt.widget.core.client.toolbar"
	xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button"
	xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid"
	xmlns:common="urn:import:com.hwacom.ngtms.common.am.view"
	xmlns:tree="urn:import:com.sencha.gxt.widget.core.client.tree">

	<ui:import field="com.sencha.gxt.widget.core.client.button.ToolButton.PLUS" />
	<ui:import field="com.sencha.gxt.widget.core.client.button.ToolButton.RIGHT" />
	
	<!-- ToolButton -->
    <ui:import field="com.sencha.gxt.widget.core.client.button.ToolButton.EXPAND" />
	<ui:import field="com.sencha.gxt.widget.core.client.button.ToolButton.COLLAPSE" />
	<ui:with field="expandAllToolTip" type="com.sencha.gxt.widget.core.client.tips.ToolTipConfig">
		<ui:attributes body="全部展開" />
	</ui:with>
	<ui:with field="collapseAllToolTip" type="com.sencha.gxt.widget.core.client.tips.ToolTipConfig">
		<ui:attributes body="全部合起" />
	</ui:with>
	
    <ui:with field="margins4444" type="com.sencha.gxt.core.client.util.Margins">
    	<ui:attributes top="4" right="4" bottom="4" left="4"/>
    </ui:with>
    
    <ui:with field="margins4440" type="com.sencha.gxt.core.client.util.Margins">
    	<ui:attributes top="4" right="4" bottom="4" left="0"/>
    </ui:with>
    
    <ui:with field="margins0004" type="com.sencha.gxt.core.client.util.Margins">
    	<ui:attributes top="0" right="0" bottom="0" left="4"/>
    </ui:with>
    
    <ui:with field="centerHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
		<ui:attributes margins="{margins4444}" height="1" width="1"/>
    </ui:with>
    <ui:with field="rightHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
		<ui:attributes margins="{margins4444}" height="1" width="300"/>
    </ui:with>

    <ui:with field="queryHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
		<ui:attributes margins="{margins4444}" height="1" width="150"/>
    </ui:with>

	<ui:with field="horizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins4444}" height="30" width="-1"/>
    </ui:with>
    <ui:with field="dateHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins4440}" height="30" width="95"/>
    </ui:with>
    <ui:with field="timeHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins4440}" height="30" width="65"/>
    </ui:with>
    <ui:with field="returnTimeHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins4440}" height="30" width="65"/>
    </ui:with>
    <ui:with field="waveHorizontalLayoutData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes margins="{margins4444}" height="30" width="10"/>
    </ui:with>
    
	<ui:with field="gridlLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
    	<ui:attributes margins="{margins4444}" height="1" width="1"/>
    </ui:with>

	<ui:with field="queryVerticalLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
    	<ui:attributes margins="{margins4444}" height="35" width="1"/>
    </ui:with>

    <ui:with field="verticalLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
    	<ui:attributes margins="{margins4444}" height="30" width="300"/>
    </ui:with>
    <ui:with field="verticalLayoutData2" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
    	<ui:attributes margins="{margins0004}" height="30" width="300"/>
    </ui:with>
    <ui:with field="timeVerticalLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
    	<ui:attributes margins="{margins0004}" height="60" width="300"/>
    </ui:with>
    <ui:with field="gridVerticalLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
    	<ui:attributes margins="{margins0004}" height="1" width="1"/>
    </ui:with>
    
   	<ui:with field="treeVerticalLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
   		<ui:attributes margins="{margins0004}" height="1" width="1"/>
   	</ui:with>
   	
   	<ui:with field="conditionVerticalLayoutData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes margins="{margins4444}" height="30" width="320"/>
    </ui:with>
    
    <ui:with field="listStore" type="com.sencha.gxt.data.shared.ListStore"/>
    <ui:with field="columnModel" type="com.sencha.gxt.widget.core.client.grid.ColumnModel"/>
    <ui:with field="gridView" type="com.sencha.gxt.widget.core.client.grid.GridView">
    	<ui:attributes stripeRows="true" forceFit="true"/>
    </ui:with>

    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="queryGroupCbStore" />
    <ui:with type="com.sencha.gxt.data.shared.LabelProvider" field="queryGroupCbLabelProvider" />
    
    <ui:with type="com.sencha.gxt.data.shared.TreeStore" field="treeStore" />
    <ui:with type="com.sencha.gxt.core.client.ValueProvider" field="treeValueProvider" />
    
    <container:HorizontalLayoutContainer>
		<container:child layoutData="{centerHorizontalLayoutData}">
			<gxt:ContentPanel headerVisible="false">
				<container:VerticalLayoutContainer scrollMode="AUTO">
				<container:child layoutData="{queryVerticalLayoutData}">
						<toolbar:ToolBar>
							<form:FieldLabel text="卡片編號"
											 labelWidth="60">
								<form:widget>
									<form:TextField ui:field="queryCard"/>
								</form:widget>
							</form:FieldLabel>
							<form:FieldLabel text="姓名"
											 labelWidth="60">
								<form:widget>
									<form:TextField ui:field="queryName"/>
								</form:widget>
							</form:FieldLabel>
							<form:FieldLabel text="群組名稱"
											 labelWidth="60">
								<form:widget>
									<form:ComboBox ui:field="queryGroupComboBox"
                                                   store="{queryGroupCbStore}"
                                                   labelProvider="{queryGroupCbLabelProvider}"
                                                   triggerAction="ALL"
                                                   editable="false" />
								</form:widget>
							</form:FieldLabel>
							<toolbar:FillToolItem />	
							<button:TextButton ui:field="exportButton"
											   width="50"
											   text="匯出" />
						</toolbar:ToolBar>
					</container:child>
					<container:child layoutData="{gridVerticalLayoutData}">
						<grid:Grid ui:field="grid"
								   store="{listStore}"
								   cm="{columnModel}"
								   view="{gridView}"
								   borders="true"
								   />
					</container:child>
				</container:VerticalLayoutContainer>
			</gxt:ContentPanel>
    	</container:child>
    	<container:child layoutData="{rightHorizontalLayoutData}">
			<gxt:ContentPanel heading="權限分配">
				<gxt:tool>
					<button:ToolButton ui:field="expandAll"
									   config="{EXPAND}"
		                               toolTipConfig="{expandAllToolTip}" />
		        </gxt:tool>
				<gxt:tool>
					<button:ToolButton ui:field="collapseAll"
		                               config="{COLLAPSE}"
		                               toolTipConfig="{collapseAllToolTip}" />
				</gxt:tool>
				<container:VerticalLayoutContainer>
					<container:child layoutData="{conditionVerticalLayoutData}">
							<form:CheckBox ui:field="updateCheckBox" 
										   boxLabel="更新卡片作業內容"/>
	    			</container:child>
	    			<container:child layoutData="{timeVerticalLayoutData}">
						<form:FieldLabel text ="作業有效日期"
                                        labelWidth="80" >
                           <form:widget>
                           		<container:VerticalLayoutContainer>
                           			<container:child layoutData="{verticalLayoutData2}">
		                           		<container:HorizontalLayoutContainer>
			                                       <container:child layoutData="{dateHorizontalLayoutData}">
			                                           <form:DateField ui:field="startDate"
			                                                           width="110"/>
			                                       </container:child>
			                                       <container:child layoutData="{waveHorizontalLayoutData}">
			                                           <g:Label text =" ~ "/>
			                                       </container:child>
		                            	</container:HorizontalLayoutContainer>
		                            </container:child>
		                            <container:child layoutData="{verticalLayoutData2}">
		                            	<container:HorizontalLayoutContainer>
	                                           <container:child layoutData="{dateHorizontalLayoutData}">
			                                           <form:DateField ui:field="endDate"
			                                                           width="110"/>
			                                    </container:child>
			                             </container:HorizontalLayoutContainer>
                                   	</container:child>
	                            </container:VerticalLayoutContainer>
                           </form:widget>
                       </form:FieldLabel>
					</container:child>
					<container:child layoutData="{treeVerticalLayoutData}">
	    				<tree:Tree ui:field="tree" 
	    						   valueProvider="{treeValueProvider}"
	    						   autoExpand="true"
	    				   		   store="{treeStore}"/>
    				</container:child>
    				<container:child layoutData="{conditionVerticalLayoutData}">
						<form:CheckBox ui:field="notAllowedCheckBox" 
									   boxLabel="不允許進入交控三樓主機房"/>
    				</container:child>
				</container:VerticalLayoutContainer>
				<gxt:button>
					<button:TextButton ui:field="issue" text="權限設定"/>
				</gxt:button>
			</gxt:ContentPanel>
    	</container:child>
    </container:HorizontalLayoutContainer>
</ui:UiBinder> 
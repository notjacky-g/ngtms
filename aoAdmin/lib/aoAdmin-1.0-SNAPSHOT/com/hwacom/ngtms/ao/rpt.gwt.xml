<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.8.1//EN" "http://www.gwtproject.org/doctype/2.8.1/gwt-module.dtd">
<module rename-to="rpt">
    <inherits name="com.hwacom.ngtms.ao.Shared" />
    <inherits name="com.hwacom.ngtms.pd.am.common"/>
    <inherits name="com.hwacom.ngtms.alarm.Shared" />
    <inherits name="com.hwacom.ngtms.room.am.common"/>

    <entry-point class="com.hwacom.ngtms.ao.am.RptEP" />

    <source path="am">
        <exclude name="**/package-info.java" />
        <exclude name="boot/Invoker.java" />
        <exclude name="server/**" />
    </source>

    <generate-with
        class="com.hwacom.ngtms.common.am.rebind.RIPViewerInitializerGenerator">
        <when-type-assignable
            class="com.hwacom.ngtms.ao.am.view.rpt.RIPViewerInitializer" />
    </generate-with>
</module>

	marshalHelperClass="com.hwacom.ngtms.ncc.tc.ct3.marshalhelper.Ct3CmsMarshalHelper">
	
	<globalParams>
		<params name="textColor">
			<bitArray byteNo="1" name="color">
				<bits name="fontColor" bitsLenth="2"/>
				<bits name="backgroundColor" bitsLenth="2"/>
				<bits name="flashSpeed" bitsLenth="2"/>
				<bits name="NA" bitsLenth="2"/>
			</bitArray>
		</params>
		<params name="fullColor">
			<value name="red" type="byte"/>
			<value name="green" type="byte"/>
			<value name="blue" type="byte"/>
		</params>
		<params name="showPatternZone">
			<value name="zoneNo" type="byte"/>
			<value name="show" type="byte" minValue="0" maxValue="1"/>
			<value name="fitSize" type="byte" minValue="0" maxValue="1"/>
			<value name="fontType" type="byte"/>
			<list name="displayList" lenByteNo="1">
				<value name="displayTime" type="byte"/>
				<value name="msgId" type="byte"/>
			</list>
		</params>
		<params name="displayShowPatternZone">
			<value name="zoneNo" type="byte"/>
			<list name="displayList" lenByteNo="1">
				<value name="displayTime" type="byte"/>
				<value name="msgId" type="byte"/>
			</list>
		</params>
		<params name="brightMap">
            <bitArray byteNo="1" name="bright">
                <bits name="sixtyFive" bitsLenth="1"/>
                <bits name="eighty" bitsLenth="1"/>
                <bits name="hundred" bitsLenth="1"/>
                <bits name="noneLight" bitsLenth="1"/>
                <bits name="releaseForce" bitsLenth="1"/>
                <bits name="force" bitsLenth="1"/>
                <bits name="noneControl" bitsLenth="1"/>
                <bits name="local" bitsLenth="1"/>
            </bitArray>
        </params>
	</globalParams>
	

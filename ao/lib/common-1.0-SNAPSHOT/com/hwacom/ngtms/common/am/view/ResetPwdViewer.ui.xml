<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
    xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button">

    <ui:with type="com.hwacom.ngtms.common.am.view.Messages" field="messages" />

    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4444">
        <ui:attributes top="4" right="4" bottom="4" left="4" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData" field="verticalLayoutData">
        <ui:attributes width="1.0" margins="{margins4444}" />
    </ui:with>

    <gxt:ContentPanel headerVisible="false">
        <gxt:widget>
            <container:VerticalLayoutContainer>
                <container:child layoutData="{verticalLayoutData}">
                    <g:Label ui:field="message" />
                </container:child>
                <container:child layoutData="{verticalLayoutData}">
                    <form:FieldLabel text="{messages.user_password}" labelWidth="80">
                        <form:widget>
                            <form:PasswordField ui:field="pwd" width="100" allowBlank="false" emptyText="{messages.user_password_validation}" />
                        </form:widget>
                    </form:FieldLabel>
                </container:child>
                <container:child layoutData="{verticalLayoutData}">
                    <form:FieldLabel text="{messages.user_confirmPassword}" labelWidth="80">
                        <form:widget>
                            <form:PasswordField ui:field="confirmPwd" width="100" allowBlank="false" emptyText="{messages.user_password_validation}" />
                        </form:widget>
                    </form:FieldLabel>
                </container:child>
            </container:VerticalLayoutContainer>
        </gxt:widget>
        <gxt:button>
            <button:TextButton ui:field="save" text="{messages.user_reset_pwd_button_save}" />
        </gxt:button>
        <gxt:button>
            <button:TextButton ui:field="clear" text="{messages.user_reset_pwd_button_clear}" />
        </gxt:button>
    </gxt:ContentPanel>
</ui:UiBinder> 
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button"
    xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
    xmlns:user="urn:import:com.hwacom.ngtms.common.am.view">

    <ui:with field="messages" type="com.hwacom.ngtms.common.am.view.Messages" />
    <ui:with field="allImages" type="com.hwacom.ngtms.common.am.images.AmImages" />

    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4044">
        <ui:attributes top="4" right="0" bottom="4" left="4" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4444">
        <ui:attributes top="4" right="4" bottom="4" left="4" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4404">
        <ui:attributes top="4" right="4" bottom="0" left="4" />
    </ui:with>

    <ui:with type="com.sencha.gxt.widget.core.client.container.MarginData" field="centerData">
        <ui:attributes margins="{margins4044}" />
    </ui:with>
    <ui:with field="eastData" type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData">
        <ui:attributes size="380" margins="{margins4444}" collapsible="true" split="true" />
    </ui:with>
    <ui:with type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData" field="basicInfoLayoutData">
        <ui:attributes width="0.95" margins="{margins4404}" />
    </ui:with>
    <ui:with field="itemData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes width="0.95" margins="{margins4404}" />
    </ui:with>
    <ui:with field="itemRadioData" type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width=".90" height="1" />
    </ui:with>
    <ui:with field="itemListData" type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData">
        <ui:attributes width="0.95" height="150" margins="{margins4404}" />
    </ui:with>

    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="store" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.ColumnModel" field="cm" />
    <ui:with type="com.sencha.gxt.widget.core.client.grid.GridView" field="view">
        <ui:attributes stripeRows="true" />
    </ui:with>

    <container:BorderLayoutContainer ui:field="borderLayoutContainer"
    								 borders="true">
        <container:center layoutData="{centerData}">
            <gxt:ContentPanel ui:field="gridContentPanel" headerVisible="false">
                <grid:Grid ui:field="grid"
                		   store="{store}"
                		   cm="{cm}"
                    	   view="{view}"
                    	   borders="false"
                    	   columnReordering="true"
                    	   stateful="true" />
            </gxt:ContentPanel>
        </container:center>
        <container:east layoutData="{eastData}">
            <gxt:FramedPanel heading="{messages.editData}" buttonAlign="CENTER">
                <container:VerticalLayoutContainer scrollMode="AUTOY">
                    <container:child layoutData="{basicInfoLayoutData}">
                        <user:UserBasicInfo ui:field="basicInfo" />
                    </container:child>
                	<container:child layoutData="{itemData}">
                		<form:FieldLabel ui:field="enableFieldLabel" text="{messages.user_enable}" labelWidth="100">
                			<form:widget>
                				<g:HorizontalPanel layoutData="{itemRadioData}">
		                            <form:Radio ui:field="enableYesRadio"
                                                boxLabel="{messages.radio_yes}" />
		                            <form:Radio ui:field="enableNoRadio"
                                                boxLabel="{messages.radio_no}" value="true" />
		                        </g:HorizontalPanel>
                			</form:widget>
                		</form:FieldLabel>
                	</container:child>
                	<container:child layoutData="{itemData}">
                		<form:FieldLabel ui:field="checkExpiredFieldLabel" text="{messages.user_checkExpired}"
                						 labelWidth="100">
                			<form:widget>
                				<g:HorizontalPanel layoutData="{itemRadioData}">
		                            <form:Radio ui:field="checkExpiredYesRadio"
		                                		boxLabel="{messages.radio_yes}" />
		                            <form:Radio ui:field="checkExpiredNoRadio"
		                                		boxLabel="{messages.radio_no}" value="true" />
		                        </g:HorizontalPanel>
                			</form:widget>
                		</form:FieldLabel>
                	</container:child>
                	<container:child layoutData="{itemData}">
                		<form:FieldLabel ui:field="startTimeFieldLabel" text="{messages.user_startTime}"
                						 labelWidth="100">
                			<form:widget>
                				<form:DateField ui:field="startTime" />
                			</form:widget>
                		</form:FieldLabel>
                	</container:child>
                	<container:child layoutData="{itemData}">
                		<form:FieldLabel ui:field="endTimeFieldLabel" text="{messages.user_endTime}"
                						 labelWidth="100">
                			<form:widget>
                				<form:DateField ui:field="endTime" />
                			</form:widget>
                		</form:FieldLabel>
                	</container:child>
                	<container:child layoutData="{itemListData}">
                		<form:FieldLabel ui:field="rolesFieldLabel" text="{messages.user_selectRoles}"
                						 labelWidth="100">
                			<form:widget>
                				<container:HorizontalLayoutContainer ui:field="listContainer" />
                			</form:widget>
                		</form:FieldLabel>
                	</container:child>
                	<container:child layoutData="{itemListData}">
                		<form:FieldLabel text="{messages.user_selectUnits}"
                						 labelWidth="100">
                			<form:widget>
                				<container:HorizontalLayoutContainer ui:field="unitListContainer" />
                			</form:widget>
                		</form:FieldLabel>
                	</container:child>
                </container:VerticalLayoutContainer>
                <gxt:button>
                    <button:TextButton ui:field="addButton"
                        			   text="{messages.button_add}" />
                </gxt:button>
                <gxt:button>
                    <button:TextButton ui:field="deleteButton"
                        			   text="{messages.button_delete}" />
                </gxt:button>
                <gxt:button>
                    <button:TextButton ui:field="saveButton"
                        			   text="{messages.button_save}" />
                </gxt:button>
            </gxt:FramedPanel>
        </container:east>
    </container:BorderLayoutContainer>
</ui:UiBinder>


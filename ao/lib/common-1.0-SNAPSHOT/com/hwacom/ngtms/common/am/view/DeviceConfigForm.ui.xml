<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form">

    <ui:with type="com.hwacom.ngtms.common.am.view.Messages" field="messages" />

    <ui:with type="com.sencha.gxt.core.client.util.Margins" field="margins4444">
        <ui:attributes top="4" right="4" bottom="4" left="4" />
    </ui:with>

    <ui:with type="com.sencha.gxt.widget.core.client.container.VerticalLayoutContainer.VerticalLayoutData" field="verticalLayoutData">
        <ui:attributes margins="{margins4444}" width="350" />
    </ui:with>

    <container:VerticalLayoutContainer ui:field="verticalLayoutContainer" scrollMode="AUTO">
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_deviceName}" labelWidth="80">
                <form:widget>
                    <form:TextField ui:field="deviceName" allowBlank="false" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_displayName}" labelWidth="80">
                <form:widget>
                    <form:TextField ui:field="displayName" allowBlank="false" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_ip}" labelWidth="80">
                <form:widget>
                    <form:TextField ui:field="ip" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_port}" labelWidth="80">
                <form:widget>
                    <form:IntegerField ui:field="port" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_project}" labelWidth="80">
                <form:widget>
                    <form:TextField ui:field="project" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel ui:field="longitudeContainer" text="{messages.deviceConfig_longitude}" labelWidth="80">
                <form:widget>
                    <form:DoubleField ui:field="longitude" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel ui:field="latitudeContainer" text="{messages.deviceConfig_latitude}" labelWidth="80">
                <form:widget>
                    <form:DoubleField ui:field="latitude" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_memo}" labelWidth="80">
                <form:widget>
                    <form:TextField ui:field="memo" />
                </form:widget>
            </form:FieldLabel>
        </container:child>
        <container:child layoutData="{verticalLayoutData}">
            <form:FieldLabel text="{messages.deviceConfig_enable}" labelWidth="80">
                <form:widget>
                    <g:HorizontalPanel>
                        <form:Radio ui:field="deviceConfigEnable" boxLabel="{messages.deviceConfig_enable_yes}" />
                        <form:Radio ui:field="deviceConfigDisable" boxLabel="{messages.deviceConfig_enable_no}" />
                    </g:HorizontalPanel>
                </form:widget>
            </form:FieldLabel>
        </container:child>
    </container:VerticalLayoutContainer>
</ui:UiBinder> 
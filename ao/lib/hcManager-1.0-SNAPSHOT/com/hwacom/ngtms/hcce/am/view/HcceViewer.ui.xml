<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
	xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
	xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button"
	xmlns:hcce="urn:import:com.hwacom.ngtms.hcce.am.view">

    <ui:style>
        .title {
            padding: 8px 12px;
            font: 32px bold;
            color: white;
            background: linear-gradient(to left, #263C52 0%,#267D71 60%,#2C7BB3 100%);
        }
    </ui:style>

	<ui:with field="messages" type="com.hwacom.ngtms.hcce.am.view.Messages" />
	<ui:with field="allImages" type="com.hwacom.ngtms.hcce.am.images.AllImages" />

	<ui:with field="headerLayoutData"
		type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
		<ui:attributes width="1" height="1" />
	</ui:with>
	<ui:with field="northLayoutData"
		type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData">
		<ui:attributes size="60" />
	</ui:with>

	<ui:with type="com.sencha.gxt.widget.core.client.TabItemConfig"
		field="mainSystemConfig">
		<ui:attributes text="{messages.hcceViewer_tabPanel_mainSystem}" />
	</ui:with>

	<ui:with type="com.sencha.gxt.widget.core.client.TabItemConfig"
		field="drSystemConfig">
		<ui:attributes text="{messages.hcceViewer_tabPanel_drSystem}" />
	</ui:with>

    <ui:with type="com.sencha.gxt.widget.core.client.TabItemConfig"
        field="switchDrConfig">
        <ui:attributes text="{messages.hcceViewer_tabPanel_switchSystem}" />
    </ui:with>

	<container:BorderLayoutContainer ui:field="rootContainer">
		<container:north layoutData="{northLayoutData}">
            <container:SimpleContainer>
                <container:child>
                    <g:Label styleName="{style.title}">HC Manager</g:Label>
                </container:child>
            </container:SimpleContainer>
		</container:north>
		<container:center>
			<gxt:TabPanel ui:field="tabPanel" tabScroll="true">
				<gxt:child config="{mainSystemConfig}">
					<hcce:SystemViewer ui:field="systemViewer"
						topologyGroup="HC_PRIMARY_GROUP" />
				</gxt:child>
				<gxt:child config="{drSystemConfig}">
					<hcce:SystemViewer ui:field="drSystemViewer"
						topologyGroup="HC_BACKUP_GROUP" />
				</gxt:child>
                <gxt:child config="{switchDrConfig}">
                    <hcce:SwitchDrViewer ui:field="switchDrViewer" />
                </gxt:child>
  			</gxt:TabPanel>
		</container:center>
	</container:BorderLayoutContainer>
</ui:UiBinder> 
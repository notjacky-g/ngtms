<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui" 
    xmlns:gxt="urn:import:com.sencha.gxt.widget.core.client"
    xmlns:container="urn:import:com.sencha.gxt.widget.core.client.container"
    xmlns:button="urn:import:com.sencha.gxt.widget.core.client.button"
    xmlns:grid="urn:import:com.sencha.gxt.widget.core.client.grid"
    xmlns:form="urn:import:com.sencha.gxt.widget.core.client.form"
    xmlns:toolbar="urn:import:com.sencha.gxt.widget.core.client.toolbar"
    xmlns:hcce="urn:import:com.hwacom.ngtms.hcce.am.view">

    <ui:with field="messages" type="com.hwacom.ngtms.hcce.am.view.Messages" />
    <ui:with field="allImages" type="com.hwacom.ngtms.hcce.am.images.AllImages" />

    <ui:with type="com.sencha.gxt.core.client.util.Margins"
        field="centerMargins">
        <ui:attributes top="0" right="0" bottom="0" left="0" />
    </ui:with>
    <ui:with type="com.sencha.gxt.core.client.util.Margins"
        field="eastMargins">
        <ui:attributes top="0" right="5" bottom="0" left="0" />
    </ui:with>
    <ui:with field="margin_10" type="com.sencha.gxt.core.client.util.Margins">
        <ui:attributes top="10" right="10" bottom="10"
            left="10" />
    </ui:with>


    <ui:with type="com.sencha.gxt.widget.core.client.container.MarginData"
        field="centerData">
        <ui:attributes margins="{centerMargins}" />
    </ui:with>
    <ui:with
        type="com.sencha.gxt.widget.core.client.container.BorderLayoutContainer.BorderLayoutData"
        field="eastData">
        <ui:attributes size="320" margins="{eastMargins}"
            collapsible="true" split="true" />
    </ui:with>

    <ui:with type="com.sencha.gxt.data.shared.ListStore" field="store" />

    <ui:with type="com.sencha.gxt.widget.core.client.grid.ColumnModel"
        field="cm" />

    <ui:with type="com.sencha.gxt.widget.core.client.grid.GridView"
        field="view">
        <ui:attributes stripeRows="true"></ui:attributes>
    </ui:with>
    <ui:with field="itemData"
        type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="1" height="30" margins="{margin_10}" />
    </ui:with>
    <ui:with field="itemTitleData"
        type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="80" height="1" />
    </ui:with>
    <ui:with field="itemValueData"
        type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="1" height="1" />
    </ui:with>
    <ui:with field="item2Data"
        type="com.sencha.gxt.widget.core.client.container.HorizontalLayoutContainer.HorizontalLayoutData">
        <ui:attributes width="1" height="100" margins="{margin_10}" />
    </ui:with>

    <container:BorderLayoutContainer
        ui:field="borderLayoutContainer" borders="true">
        <container:center layoutData="{centerData}">
            <gxt:ContentPanel headerVisible="false">
                <grid:Grid ui:field="grid" store="{store}" cm="{cm}"
                    view="{view}" borders="false" columnReordering="true"
                    stateful="true" />
            </gxt:ContentPanel>
        </container:center>
        <container:east layoutData="{eastData}">
            <gxt:FramedPanel
                heading="{messages.mainSystemViewer_editPanelTitle}"
                buttonAlign="CENTER">
                <container:VerticalLayoutContainer>
                    <container:HorizontalLayoutContainer
                        layoutData="{itemData}">
                        <toolbar:LabelToolItem
                            label="{messages.topologyConfigGrid_groupName}："
                            layoutData="{itemTitleData}" />
                        <form:TextField ui:field="groupName"
                            allowBlank="false" layoutData="{itemValueData}" />
                    </container:HorizontalLayoutContainer>
                    <container:HorizontalLayoutContainer
                        layoutData="{itemData}">
                        <toolbar:LabelToolItem
                            label="{messages.topologyConfigGrid_nodeName}："
                            layoutData="{itemTitleData}" />
                        <form:TextField ui:field="nodeName"
                            allowBlank="false" layoutData="{itemValueData}" />
                    </container:HorizontalLayoutContainer>
                    <container:HorizontalLayoutContainer
                        layoutData="{item2Data}">
                        <toolbar:LabelToolItem
                            label="{messages.topologyConfigGrid_description}："
                            layoutData="{itemTitleData}" />
                        <form:TextArea ui:field="description"
                            allowBlank="true" layoutData="{itemValueData}" />
                    </container:HorizontalLayoutContainer>
                </container:VerticalLayoutContainer>
                <gxt:button>
                    <button:TextButton ui:field="addButton"
                        text="{messages.mainSystemViewer_button_add}" />
                </gxt:button>
                <gxt:button>
                    <button:TextButton ui:field="deleteButton"
                        text="{messages.mainSystemViewer_button_delete}" />
                </gxt:button>
                <gxt:button>
                    <button:TextButton ui:field="saveButton"
                        text="{messages.mainSystemViewer_button_save}" />
                </gxt:button>
            </gxt:FramedPanel>
        </container:east>
    </container:BorderLayoutContainer>
</ui:UiBinder>

